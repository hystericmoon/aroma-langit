{
  "name": "aroma-langit",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "cross-env SITE_ENV=staging astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "vitest run --config vitest.seed.config.ts",
    "package:hosting": "npm run build && node scripts/package-hosting.mjs",
    "package:hosting:staging": "npm run build:staging && node scripts/package-hosting.mjs --staging",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/client": "^8.10.1",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@types/three": "^0.186.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
