---
import Base from '../layouts/Base.astro';
import Figure from '../components/ui/Figure.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Band from '../components/ui/Band.astro';
import Kitchen from '../components/home/Kitchen.astro';
import { photos } from '../data/photos';
import { getSite } from '../lib/content';

const site = await getSite();
const pillars = [
  { name: 'Tampilan', text: 'Makanan dinikmati dengan mata lebih dulu, jadi setiap kotak dan meja saji kami tata dengan rapi.' },
  { name: 'Aroma', text: 'Separuh dari nama kami. Wangi bumbu Nusantara yang membuat tamu menghampiri meja saji lebih dulu.' },
  { name: 'Rasa', text: 'Resep Nusantara yang kami masak sejak rumah makan pertama di Jatinangor, ditambah sajian populer yang dicari tamu.' },
];
---

<Base
  title="Tentang kami"
  description="Aroma Langit berawal dari rumah makan prasmanan di Jatinangor pada 2017 dan kini menjadi dapur katering bersertifikat halal di Bogor. Kenali cerita, tim dan dapur kami."
>
  <section class="head" aria-labelledby="a-title">
    <div class="wrap head-grid">
      <h1 id="a-title" class="t-display a-title">
        <span class="intro-line"><span>Tentang</span></span>
        <span class="intro-line"><span>Aroma Langit</span></span>
      </h1>
      <div class="head-copy">
        <p class="t-lead">
          Aroma Langit lahir dari mimpi sederhana: menggapai cita-cita setinggi langit sambil menebarkan aroma masakan yang membuat orang betah duduk lebih lama.
        </p>
        <p class="t-body measure">
          Kami mulai sebagai rumah makan prasmanan bercita rasa Nusantara di Jatinangor, Sumedang, pada Februari 2017. Ayam Bakar Kalasan, Rendang, Nila Bumbu Cobek, Gepuk dan Sayur Urap menjadi andalan kami saat menjamu mahasiswa dan warga sekitar.
        </p>
      </div>
    </div>
  </section>

  <section class="story" aria-labelledby="s-title">
    <div class="wrap">
      <SectionHeading id="s-title" title="Dari rumah makan ke katering" split />
    </div>
    <div class="wrap story-grid">
      <Figure photo={photos.hidanganFlatlay} ratio="3/2" class="story-photo" sizes="(min-width: 1024px) 46vw, 100vw" widths={[480, 720, 994]} />
      <div class="story-copy" data-reveal>
        <p class="t-body measure">
          Di akhir 2017 kami memutuskan fokus pada jasaboga dan memindahkan dapur ke Cinambo, Bandung. Sejak itu kami melayani pelanggan perorangan, instansi pemerintah dan swasta, sampai perusahaan besar.
        </p>
        <p class="t-body measure">
          Kini dapur kami berada di Pasir Kuda, Bogor Barat, dengan kantor di Bogor Nirwana Residence. Tujuan kami tetap sama: memberi manfaat sebesar-besarnya bagi orang-orang di sekitar dapur kami.
        </p>
      </div>
    </div>
  </section>

  <Band id="t-title" label="Perjalanan kami" class="timeline">
    <ol role="list" class="stubs" data-reveal>
      {
        site.milestones.map((m) => (
          <li class="stub">
            <p class="when">{m.when}</p>
            <p class="what">{m.text}</p>
          </li>
        ))
      }
    </ol>
  </Band>

  <section class="pillars" aria-labelledby="p-title">
    <div class="wrap">
      <SectionHeading id="p-title" title="Tiga hal di setiap sajian" split />
      <ul role="list" class="p-list" data-reveal>
        {
          pillars.map((p) => (
            <li>
              <h3 class="p-name">{p.name}</h3>
              <p class="t-body">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="team" aria-labelledby="tm-title">
    <div class="wrap">
      <SectionHeading id="tm-title" title="Orang-orang di balik dapur" split />
      <ul role="list" class="cards" data-reveal>
        {
          site.team.map((t) => (
            <li class="card">
              <p class="role">{t.role}</p>
              <h3 class="name">{t.name}</h3>
              <p class="t-body bio">{t.bio}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Kitchen />
</Base>

<style>
  /* Tentang kami: no page recipe in the brand book; built from its components (white cards,
     the timeline as a Band card, the kitchen section with trust stamps). */
  .head-grid {
    display: grid;
    gap: var(--spacing-3);
    padding-block: var(--spacing-4) var(--section-space);
  }
  /* The reveal mask leaves room above (Fraunces ascenders) and below (descenders). */
  .a-title .intro-line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.1em;
    margin-block: -0.12em -0.1em;
  }
  .a-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  .a-title .intro-line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .head-copy {
    display: grid;
    gap: var(--spacing-2);
    align-content: end;
  }

  .story,
  .pillars,
  .team {
    padding-bottom: var(--section-space);
  }
  .story-grid {
    display: grid;
    gap: var(--spacing-3);
    margin-top: var(--spacing-3);
    align-items: start;
  }
  .story-copy {
    display: grid;
    gap: var(--spacing-2);
  }

  .stubs {
    display: grid;
    margin: 0;
    padding: 0;
  }
  .stub {
    display: grid;
    gap: 4px;
    padding: var(--spacing-2) 0;
  }
  .stub + .stub {
    border-top: 1px solid var(--color-rule-soft);
  }
  .when {
    font: 700 20px/1.3 var(--font-sans);
  }

  .p-list,
  .cards {
    display: grid;
    gap: 12px;
    margin-top: var(--spacing-3);
  }
  .p-list li,
  .card {
    display: grid;
    align-content: start;
    gap: var(--spacing-1);
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .p-name,
  .name {
    font: 700 20px/1.3 var(--font-sans);
  }
  .role {
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .p-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stub {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--spacing-3);
      align-items: baseline;
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--spacing-5);
      align-items: end;
    }
    .story-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--spacing-5);
    }
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
