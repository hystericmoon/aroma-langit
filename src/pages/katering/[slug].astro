---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Figure from '../../components/ui/Figure.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Chip from '../../components/ui/Chip.astro';
import Icon from '../../components/ui/Icon.astro';
import PackageSheet from '../../components/PackageSheet.astro';
import Terms from '../../components/Terms.astro';
import { getServices, getSite } from '../../lib/content';
import { formatRupiah } from '../../lib/order';
import type { Service } from '../../data/types';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const services = await getServices();
const site = await getSite();
const prices = service.packages.map((p) => p.price);
const lo = Math.min(...prices);
const hi = Math.max(...prices);
const others = services.filter((s) => s.slug !== service.slug);
const gallery = service.gallery.filter((g) => g !== service.photo);
const minOrders = service.packages.map((p) => p.minOrder);
const minLo = Math.min(...minOrders);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: `${service.title} Aroma Langit`,
    url: new URL(`/katering/${service.slug}/`, Astro.site).href,
    itemListElement: service.packages.map((p) => ({
      '@type': 'Offer',
      name: `${service.title} ${p.name}`,
      price: p.price,
      priceCurrency: 'IDR',
      eligibleQuantity: { '@type': 'QuantitativeValue', minValue: p.minOrder, unitText: p.unit },
      seller: { '@id': `${Astro.site}#business` },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: service.title, item: new URL(`/katering/${service.slug}/`, Astro.site).href },
    ],
  },
];
---

<Base
  title={`${service.title} di Bogor, mulai ${formatRupiah(lo)}`}
  description={`${service.title} Aroma Langit: ${service.packages.length} paket dari ${formatRupiah(lo)} sampai ${formatRupiah(hi)} per ${service.unit}. ${service.tagline} Halal BPJPH, antar se-Kota Bogor.`}
  schema={schema}
>
  <section class="head" aria-labelledby="svc-title">
    <div class="wrap head-grid">
      <div class="head-copy">
        <h1 id="svc-title" class="t-display svc-title">
          <span class="intro-line"><span>{service.title}</span></span>
        </h1>
        <p class="t-lead tagline">{service.tagline}</p>
        <p class="t-body measure intro">{service.intro}</p>
        <dl class="facts tab">
          <div><dt>Harga</dt><dd>{lo === hi ? formatRupiah(lo) : `${formatRupiah(lo)}–${formatRupiah(hi)}`}<span class="per">/{service.unit}</span></dd></div>
          <div><dt>Minimum</dt><dd>{minLo > 1 ? `${minLo} ${service.unit}` : `1 ${service.unit}`}</dd></div>
          <div><dt>Pesan paling lambat</dt><dd>H-{service.leadDays}</dd></div>
        </dl>
        <div class="actions">
          <a class="ui-btn ui-btn--primary" href={`/?layanan=${service.slug}#pesan`}>Susun pesanan {service.title}</a>
          <a class="ui-link pdf" href={site.pricelistUrl} download>Unduh daftar harga (PDF)</a>
        </div>
      </div>
      <Figure photo={service.photo} ratio="4/3" class="head-photo" sizes="(min-width: 1024px) 46vw, 100vw" priority widths={[480, 720, 960, 1280, 1600]} />
    </div>
  </section>

  <section class="packages" aria-labelledby="pkg-title">
    <div class="wrap">
      <SectionHeading
        id="pkg-title"
        title={`${service.packages.length} paket ${service.title.toLowerCase()}`}
        context={`${service.packages.length > 1 ? 'Diurutkan dari yang paling lengkap. ' : ''}Harga per ${service.unit}, sudah termasuk antar se-Kota Bogor untuk pesanan yang memenuhi minimum.`}
        split
      />
      <div class="sheet">
        {service.packages.map((p, i) => <PackageSheet pkg={p} serviceSlug={service.slug} serviceTitle={service.title} index={i} />)}
      </div>
    </div>
  </section>

  {
    service.choices && service.choices.length > 0 && (
      <section class="choices" aria-labelledby="choice-title">
        <div class="wrap">
          <SectionHeading id="choice-title" title="Pilih sendiri isinya." split />
          <div class="choice-lists">
            {service.choices.map((c) => (
              <div class="choice">
                <h3 class="choice-h">{c.label}</h3>
                <ul role="list" class="chips">
                  {c.items.map((it) => (
                    <li>
                      <Chip variant="outline">{it}</Chip>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    gallery.length > 0 && (
      <section class="gallery" aria-labelledby="gal-title">
        <div class="wrap">
          <SectionHeading id="gal-title" title="Dari dapur kami." split />
          <div class:list={['gal', `gal-${Math.min(gallery.length, 4)}`]} data-reveal>
            {gallery.slice(0, 4).map((g) => (
              <Figure photo={g} ratio="1/1" sizes="(min-width: 1024px) 30vw, 50vw" widths={[480, 720, 960]} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Terms service={service} />

  <section class="others" aria-labelledby="others-title">
    <div class="wrap">
      <SectionHeading id="others-title" title="Layanan lain" split />
      <ul role="list" class="o-list" data-reveal>
        {
          others.map((o) => (
            <li>
              <a class="o-card" href={`/katering/${o.slug}/`}>
                <span class="o-img">
                  <Photo photo={o.photo} sizes="(min-width: 1024px) 18vw, 45vw" widths={[360, 540]} alt="" />
                </span>
                <span class="o-name">
                  {o.title}
                  <Icon name="arrow-right" />
                </span>
                <span class="o-price tab">mulai {formatRupiah(Math.min(...o.packages.map((p) => p.price)))}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Service page (brand book §7 recipe): SectionHeading → PriceRows with menu Tabs → Figures →
     terms list. Read mode except the package actions. */
  .head-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-4) var(--section-space);
  }
  .head-copy {
    display: grid;
    gap: var(--spacing-3);
    align-content: center;
  }
  .svc-title .intro-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .svc-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .intro {
    color: var(--color-ink-muted);
  }
  .facts {
    display: grid;
    margin: 0;
    border-top: var(--hairline);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-2);
    padding: 10px 0;
  }
  .facts div + div {
    border-top: 1px solid var(--color-rule-soft);
  }
  .facts dt {
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .per {
    font-weight: 400;
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2) var(--spacing-3);
  }
  .pdf {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .packages,
  .choices,
  .gallery,
  .others {
    padding-block: 0 var(--section-space);
  }
  .sheet {
    margin-top: var(--spacing-3);
  }

  .choice-lists {
    display: grid;
    gap: var(--spacing-3);
    margin-top: var(--spacing-3);
  }
  .choice-h {
    margin-bottom: 12px;
    font: 400 22px/1.2 var(--font-display);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1);
  }

  .gal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: var(--spacing-3);
  }

  /* Photo links to the other services: read mode (not one of the 12 components, flagged). */
  .o-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-3) 12px;
    margin-top: var(--spacing-3);
  }
  .o-card {
    display: grid;
    gap: 6px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .o-img {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-kraft);
  }
  .o-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .o-name {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-1);
    margin-top: 4px;
    font: 400 22px/1.2 var(--font-display);
  }
  .o-card:hover .o-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .o-price {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-brown);
  }

  @media (min-width: 600px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .facts div {
      display: grid;
      gap: 2px;
      padding: 12px 12px 0 0;
    }
    .facts div + div {
      padding-left: 12px;
      border-top: 0;
      border-left: 1px solid var(--color-rule-soft);
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--spacing-5);
      align-items: center;
    }
    .choice-lists {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-4);
    }
    .gal {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .gal-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .gal-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gal-1 {
      grid-template-columns: minmax(0, 0.6fr);
    }
    .o-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
