---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import PackageSheet from '../../components/PackageSheet.astro';
import Terms from '../../components/Terms.astro';
import { getServices, getSite } from '../../lib/content';
import { formatRupiah } from '../../lib/order';
import type { Service } from '../../data/types';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const services = await getServices();
const site = await getSite();
const prices = service.packages.map((p) => p.price);
const lo = Math.min(...prices);
const hi = Math.max(...prices);
const others = services.filter((s) => s.slug !== service.slug);
const gallery = service.gallery.filter((g) => g !== service.photo);
const minOrders = service.packages.map((p) => p.minOrder);
const minLo = Math.min(...minOrders);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: `${service.title} Aroma Langit`,
    url: new URL(`/katering/${service.slug}/`, Astro.site).href,
    itemListElement: service.packages.map((p) => ({
      '@type': 'Offer',
      name: `${service.title} ${p.name}`,
      price: p.price,
      priceCurrency: 'IDR',
      eligibleQuantity: { '@type': 'QuantitativeValue', minValue: p.minOrder, unitText: p.unit },
      seller: { '@id': `${Astro.site}#business` },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: service.title, item: new URL(`/katering/${service.slug}/`, Astro.site).href },
    ],
  },
];
---

<Base
  title={`${service.title} di Bogor, mulai ${formatRupiah(lo)}`}
  description={`${service.title} Aroma Langit: ${service.packages.length} paket dari ${formatRupiah(lo)} sampai ${formatRupiah(hi)} per ${service.unit}. ${service.tagline} Halal BPJPH, antar se-Kota Bogor.`}
  schema={schema}
>
  <section class="head field-orange" aria-labelledby="svc-title">
    <div class="wrap head-grid">
      <div class="head-copy">
        <h1 id="svc-title" class="t-display svc-title">
          <span class="intro-line"><span>{service.title}</span></span>
        </h1>
        <p class="t-lead tagline">{service.tagline}</p>
        <p class="t-body measure">{service.intro}</p>
        <dl class="facts tab">
          <div><dt>Harga</dt><dd>{lo === hi ? formatRupiah(lo) : `${formatRupiah(lo)}–${formatRupiah(hi)}`}<span class="per">/{service.unit}</span></dd></div>
          <div><dt>Minimum</dt><dd>{minLo > 1 ? `${minLo} ${service.unit}` : `1 ${service.unit}`}</dd></div>
          <div><dt>Pesan paling lambat</dt><dd>H-{service.leadDays}</dd></div>
        </dl>
        <div class="actions">
          <a class="btn" href={`/?layanan=${service.slug}#pesan`}>Susun pesanan {service.title}</a>
          <a class="link pdf" href={site.pricelistUrl} download>Unduh daftar harga (PDF)</a>
        </div>
      </div>
      <figure class="head-photo">
        <div class="pan" data-parallax="5">
          <Photo photo={service.photo} sizes="(min-width: 1024px) 46vw, 100vw" priority widths={[480, 720, 960, 1280, 1600]} />
        </div>
      </figure>
    </div>
  </section>

  <section class="packages field-paper-2" aria-labelledby="pkg-title">
    <div class="wrap">
      <div class="pk-head">
        <h2 id="pkg-title" class="t-h2" data-split>{service.packages.length} paket {service.title.toLowerCase()}</h2>
        <p class="t-lead pk-lead">
          {service.packages.length > 1 ? 'Diurutkan dari yang paling lengkap.' : ''} Harga per {service.unit}, sudah termasuk antar se-Kota Bogor untuk pesanan yang memenuhi minimum.
        </p>
      </div>
      <div class="sheet field-paper edge-y">
        {service.packages.map((p, i) => <PackageSheet pkg={p} serviceSlug={service.slug} serviceTitle={service.title} index={i} />)}
      </div>
    </div>
  </section>

  {
    service.choices && service.choices.length > 0 && (
      <section class="choices field-ink on-dark" aria-labelledby="choice-title">
        <div class="wrap choice-grid">
          <h2 id="choice-title" class="t-h2" data-split>Pilih sendiri isinya.</h2>
          <div class="choice-lists">
            {service.choices.map((c) => (
              <div class="choice">
                <h3 class="choice-h">{c.label}</h3>
                <ul role="list" class="chips">
                  {c.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    gallery.length > 0 && (
      <section class="gallery field-paper" aria-labelledby="gal-title">
        <div class="wrap">
          <h2 id="gal-title" class="t-h2 gal-title" data-split>Dari dapur kami.</h2>
          <div class:list={['gal', `gal-${Math.min(gallery.length, 4)}`]} data-reveal>
            {gallery.slice(0, 4).map((g) => (
              <figure class="gal-item">
                <Photo photo={g} sizes="(min-width: 1024px) 30vw, 50vw" widths={[480, 720, 960]} />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Terms service={service} />

  <section class="others field-orange" aria-labelledby="others-title">
    <div class="wrap">
      <h2 id="others-title" class="t-h2" data-split>Layanan lain</h2>
      <ul role="list" class="o-list" data-reveal>
        {
          others.map((o) => (
            <li>
              <a class="o-card" href={`/katering/${o.slug}/`}>
                <span class="o-img">
                  <Photo photo={o.photo} sizes="(min-width: 1024px) 18vw, 45vw" widths={[360, 540]} alt="" />
                </span>
                <span class="o-name">{o.title}</span>
                <span class="o-price tab">mulai {formatRupiah(Math.min(...o.packages.map((p) => p.price)))}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/tabs';
</script>

<style>
  .head {
    padding-block: clamp(40px, 6vw, 88px) clamp(64px, 8vw, 120px);
  }
  .head-grid {
    display: grid;
    gap: 40px;
  }
  .head-copy {
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .svc-title {
    font-size: clamp(3.5rem, 1rem + 9vw, 9.5rem);
  }
  .svc-title .intro-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }
  .svc-title .intro-line > span {
    display: block;
    animation: rise 1100ms var(--ease-out) both;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  .tagline {
    max-width: 26ch;
    font-weight: 650;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2px;
  }
  .facts div {
    padding: 14px 18px;
    background: var(--paper);
  }
  .facts dt {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }
  .facts dd {
    font-weight: 800;
    font-size: 1.125rem;
  }
  .per {
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }
  .pdf {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }
  .head-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink);
  }
  .pan {
    height: 110%;
    margin-top: -5%;
  }
  .pan :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .field-paper-2 {
    background: var(--paper-2);
  }
  .packages {
    padding-block: var(--section);
  }
  .pk-head {
    display: grid;
    gap: 20px;
    align-items: end;
  }
  .pk-lead {
    max-width: 40ch;
  }
  .sheet {
    display: grid;
    gap: clamp(64px, 7vw, 112px);
    margin-top: clamp(40px, 5vw, 72px);
    padding: clamp(56px, 6vw, 96px) clamp(20px, 4.5vw, 72px);
  }

  .choices {
    padding-block: var(--section);
  }
  .choice-grid {
    display: grid;
    gap: 40px;
  }
  .choice-lists {
    display: grid;
    gap: 40px;
  }
  .choice-h {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 14px;
    color: var(--peach);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 10px 16px;
    background: var(--ink-2);
    font-weight: 700;
  }

  .gallery {
    padding-block: var(--section);
  }
  .gal-title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .gal {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gal-item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-2);
  }
  .gal-1 .gal-item {
    aspect-ratio: 16 / 9;
    grid-column: 1 / -1;
  }
  .gal-3 .gal-item:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .gal-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .gal-item:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .others {
    padding-block: var(--section);
  }
  .o-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .o-card {
    display: grid;
    gap: 4px;
    padding-bottom: 14px;
    background: var(--paper);
    text-decoration: none;
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .o-card:hover {
      transform: translateY(-4px);
    }
  }
  .o-img {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--ink);
  }
  .o-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .o-card:hover .o-img :global(img) {
      transform: scale(1.05);
    }
  }
  .o-name {
    padding: 10px 14px 0;
    font-weight: 800;
    font-size: 1.125rem;
  }
  .o-price {
    padding: 0 14px;
    font-size: var(--step-small);
    color: var(--muted);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 96px);
      align-items: center;
    }
    .pk-head {
      grid-template-columns: 1fr 1fr;
    }
    .choice-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .gal {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .gal-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gal-3 .gal-item:first-child {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }
    .gal-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .o-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
