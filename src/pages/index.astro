---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import MenuSheet from '../components/home/MenuSheet.astro';
import OrderLabel from '../components/home/OrderLabel.astro';
import Showcase from '../components/home/Showcase.astro';
import Steps from '../components/home/Steps.astro';
import Kitchen from '../components/home/Kitchen.astro';
import Proof from '../components/home/Proof.astro';
import Corporate from '../components/home/Corporate.astro';
import CalculatorTeaser from '../components/home/CalculatorTeaser.astro';
---

<Base
  title="Aroma Langit · Katering halal di Bogor"
  description="Nasi box, bento, snack box, prasmanan dan tumpeng dari dapur bersertifikat halal di Pasir Kuda, Bogor. Lihat harga, susun pesanan, kirim lewat WhatsApp."
>
  {/* Brand book §7 home recipe: hero → event tiles → price list beside the order panel →
      gallery → (how to order) → kitchen and certificates → navy band → (corporate form). */}
  <Hero />
  <CalculatorTeaser />
  <div class="wrap price-and-order">
    <MenuSheet />
    <OrderLabel />
  </div>
  <Showcase />
  <Steps />
  <Kitchen />
  <Proof />
  <Corporate />
</Base>

<style>
  .price-and-order {
    display: grid;
    gap: var(--spacing-5);
    padding-bottom: var(--section-space);
  }
  /* Side by side from about 1000px; the order panel keeps to 440px. */
  @media (min-width: 1000px) {
    .price-and-order {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 440px);
      gap: var(--spacing-4);
      align-items: start;
    }
  }
</style>
