---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import { getServices } from '../lib/content';
const services = await getServices();
---

<Base title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada di situs Aroma Langit." noindex closing={false}>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf-grid">
      <h1 id="nf-title" class="t-display" data-split>Kotaknya kosong.</h1>
      <div class="nf-copy">
        <p class="t-lead">Halaman ini tidak ada, atau sudah pindah. Layanan aqiqah dan pemasok grosir juga sudah tidak kami buka.</p>
        <a class="ui-btn ui-btn--primary" href="/">Kembali ke beranda</a>
      </div>
    </div>
  </section>

  <section class="menu" aria-labelledby="nf-menu">
    <div class="wrap">
      <SectionHeading id="nf-menu" title="Kotak yang masih kami isi" />
      <ul role="list" class="tiles">
        {
          services.map((s) => (
            <li>
              <ServiceCard service={s} sizes="(min-width: 1024px) 30vw, 45vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* 404: the services as ServiceCards (brand book §8), two across on phones. */
  .nf-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-5) var(--section-space);
  }
  .nf-copy {
    display: grid;
    gap: var(--spacing-3);
    justify-items: start;
    max-width: 36rem;
  }
  .menu {
    padding-bottom: var(--section-space);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: var(--spacing-3);
  }
  @media (min-width: 1024px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--spacing-5);
    }
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
