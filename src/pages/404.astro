---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import { getServices } from '../lib/content';
import { formatRupiah } from '../lib/order';
const services = await getServices();
const from = (s: (typeof services)[number]) => {
  const cheapest = s.packages.reduce((a, b) => (b.price < a.price ? b : a));
  return `Mulai ${formatRupiah(cheapest.price)}/${cheapest.unit}`;
};
---

<Base title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada di situs Aroma Langit." noindex closing={false}>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf-grid">
      <h1 id="nf-title" class="t-display" data-split>Kotaknya kosong.</h1>
      <div class="nf-copy">
        <p class="t-lead">Halaman ini tidak ada, atau sudah pindah. Layanan aqiqah dan pemasok grosir juga sudah tidak kami buka.</p>
        <a class="ui-btn ui-btn--primary" href="/">Kembali ke beranda</a>
      </div>
    </div>
  </section>

  <section class="menu" aria-labelledby="nf-menu">
    <div class="wrap">
      <SectionHeading id="nf-menu" title="Kotak yang masih kami isi" />
      <ul role="list" class="tiles">
        {
          services.map((s) => (
            <li>
              <a class="tile" href={`/katering/${s.slug}/`}>
                <span class="tile-photo">
                  <Photo photo={s.photo} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" widths={[480, 720, 960]} alt="" />
                </span>
                <span class="tile-name">
                  {s.title}
                  <Icon name="arrow-right" />
                </span>
                <span class="tile-from tab">{from(s)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* 404: read mode. The service links are photo links like "Layanan lain" (flagged). */
  .nf-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-5) var(--section-space);
  }
  .nf-copy {
    display: grid;
    gap: var(--spacing-3);
    justify-items: start;
    max-width: 36rem;
  }
  .menu {
    padding-bottom: var(--section-space);
  }
  .tiles {
    display: grid;
    gap: var(--spacing-3) 12px;
    margin-top: var(--spacing-3);
  }
  .tile {
    display: grid;
    gap: 6px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .tile-photo {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-kraft);
  }
  .tile-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile-name {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-1);
    margin-top: 4px;
    font: 400 24px/1.2 var(--font-display);
  }
  .tile:hover .tile-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .tile-from {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-brown);
  }
  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--spacing-5);
    }
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
