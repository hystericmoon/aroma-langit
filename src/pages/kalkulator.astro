---
import Base from '../layouts/Base.astro';
import ItemRow from '../components/calculator/ItemRow.astro';
import ReceiptLine from '../components/calculator/ReceiptLine.astro';
import { getPresets, getServices, getSite } from '../lib/content';
import { buildCatalog, computePlan, generalTermsApply, planFromPreset, quantityFor, type PlanItem } from '../lib/calculator';
import { weddingCatering } from '../data/wedding';
import { formatRupiah, areaLabel, formatDateLong, shippingLabel, depositAmount, settlementText } from '../lib/order';
import EventTile from '../components/ui/EventTile.astro';
import Choice from '../components/ui/Choice.astro';
import Icon from '../components/ui/Icon.astro';
import StickyOrderBar from '../components/ui/StickyOrderBar.astro';
import NotaDeposit from '../components/ui/NotaDeposit.astro';

const services = await getServices();
const site = await getSite();
const presets = await getPresets();
const catalog = buildCatalog(services, weddingCatering);
const first = presets[0];
const plan = planFromPreset(first, catalog);
plan.items.forEach((it, i) => (it.id = `s${i}`));
const result = computePlan(plan, catalog);
const qtyText = (item: PlanItem) => {
  const s = catalog.find((c) => c.slug === item.service)!;
  const p = s.packages.find((x) => x.id === item.pkg)!;
  return `= ${quantityFor(item, s, plan.guests).toLocaleString('id-ID')} ${p.unit}`;
};
const blank: PlanItem = { id: '__ID__', label: '', service: catalog[0].slug, pkg: catalog[0].packages[0].id, variant: '', mode: 'per-guest', perGuest: 1, fixed: 1 };
const terms = { depositRate: site.depositRate, settlementDays: site.settlementDays };
const data = { catalog, presets, csPhone: site.csPhone, marketingPhone: site.marketingPhone, terms };
---

<Base
  title="Kalkulator katering"
  description="Hitung kebutuhan katering acara Anda: pilih jenis acara, atur jumlah tamu, ubah menu dan jumlahnya, lalu kirim rinciannya ke WhatsApp Aroma Langit."
>
  <section class="head" aria-labelledby="calc-title">
    <div class="wrap head-grid">
      <h1 id="calc-title" class="t-display c-title">
        <span class="intro-line"><span>Kalkulator</span></span>
        <span class="intro-line"><span>katering</span></span>
      </h1>
      <p class="t-lead head-lead">
        Pilih jenis acara, atur jumlah tamu, lalu ubah isinya sesuka Anda. Notanya menghitung semuanya, termasuk minimum pesanan dan tanggal paling cepat.
      </p>
    </div>
  </section>

  <section class="app" id="hitung" aria-label="Kalkulator">
    <noscript>
      <p class="wrap noscript">Kalkulator ini memerlukan JavaScript. Anda tetap bisa melihat <a class="ui-link" href={site.pricelistUrl}>daftar harga (PDF)</a> atau bertanya lewat <a class="ui-link" href={`https://wa.me/${site.csPhone}`}>WhatsApp</a>.</p>
    </noscript>
    <div class="wrap app-grid">
      <form class="controls" data-calc-form novalidate>
        <fieldset class="block presets">
          <legend class="step">Jenis acara</legend>
          <div class="preset-list">
            {
              presets.map((p) => (
                <EventTile
                  name="preset"
                  value={p.id}
                  checked={p.id === first.id}
                  title={p.title}
                  desc={p.description}
                  meta={p.items.length ? `${p.guests} ${p.guestWord}` : 'Kosong'}
                  inputAttrs={{ 'data-preset': true }}
                  class:list={['preset', !p.items.length && 'ui-tile--kraft']}
                />
              ))
            }
          </div>
          <p class="status" role="status" data-status></p>
        </fieldset>

        <div class="block guests">
          <label class="step" for="calc-guests">Jumlah <span data-guest-word>{first.guestWord}</span></label>
          <div class="guest-row">
            <div class="ui-stepper">
              <button type="button" class="ui-btn ui-btn--secondary ui-btn--icon" data-guest-step="-1" aria-label="Kurangi jumlah tamu">
                <Icon name="minus" />
              </button>
              <input id="calc-guests" class="ui-input ui-input--number" type="number" inputmode="numeric" min="1" max="5000" value={plan.guests} data-guests />
              <button type="button" class="ui-btn ui-btn--secondary ui-btn--icon" data-guest-step="1" aria-label="Tambah jumlah tamu">
                <Icon name="plus" />
              </button>
            </div>
            <input type="range" class="range" min="10" max="1000" step="5" value={plan.guests} aria-label="Geser jumlah tamu" data-guests-range />
          </div>
        </div>

        <div class="block">
          <div class="items-head">
            <h2 class="step">Isi pesanan</h2>
            <p class="items-hint">Ganti paket, hitung per tamu atau dengan jumlah tetap, dan beri nama setiap baris.</p>
          </div>
          <ol class="items" role="list" data-items>
            {plan.items.map((it) => <ItemRow item={it} catalog={catalog} qtyText={qtyText(it)} />)}
          </ol>
          <p class="empty" data-empty hidden>Belum ada menu. Tambahkan yang pertama.</p>
          <button type="button" class="ui-btn ui-btn--secondary add" data-add>
            <Icon name="plus" />
            Tambah menu
          </button>
        </div>

        <div class="block logistics">
          <div class="ui-field">
            <label class="step" for="calc-date">Tanggal acara</label>
            <input id="calc-date" class="ui-input" type="date" data-date aria-describedby="calc-date-help" />
            <p id="calc-date-help" class="ui-help help" data-date-help>Pilih tanggal untuk memeriksa waktu pemesanan.</p>
          </div>
          <Choice
            name="calc-area"
            legend="Diantar ke"
            legendClass="step"
            options={[
              { value: 'kota-bogor', label: 'Kota Bogor', checked: true, attrs: { 'data-area': true } },
              { value: 'luar-bogor', label: 'Luar Kota Bogor', attrs: { 'data-area': true } },
            ]}
          />
        </div>
      </form>

      <aside class="side" aria-labelledby="nota-title">
        {/* Nota (brand book §7). */}
        <div class="ui-nota receipt" id="nota" data-receipt>
          <header class="r-head">
            <div>
              <h2 id="nota-title" class="ui-nota__eyebrow r-title">Nota perkiraan</h2>
              <p class="r-event" data-r-event>{first.title}</p>
            </div>
            <img class="r-mark" src="/brand/logo-icon.svg" width="36" height="36" alt="" />
          </header>
          <dl class="ui-nota__lines r-meta">
            <div class="ui-nota__line"><dt>Jumlah</dt><dd data-r-guests>{plan.guests} {first.guestWord}</dd></div>
            <div class="ui-nota__line"><dt>Tanggal</dt><dd data-r-date>Belum dipilih</dd></div>
            <div class="ui-nota__line"><dt>Diantar ke</dt><dd data-r-area>{areaLabel[plan.area]}</dd></div>
          </dl>
          <ol class="lines" role="list" data-lines>
            {result.lines.map((l) => <ReceiptLine line={l} />)}
          </ol>
          <p class="r-empty" data-r-empty hidden>Tambahkan menu untuk melihat perkiraannya.</p>
          <dl class="ui-nota__lines r-sums tab">
            <div class="ui-nota__line"><dt>Subtotal</dt><dd data-r-sub>{formatRupiah(result.subtotal)}</dd></div>
            <div class="ui-nota__line ui-nota__line--surcharge" data-r-extra-row hidden><dt>Biaya di bawah minimum</dt><dd data-r-extra>{formatRupiah(result.surcharge)}</dd></div>
            <div class="ui-nota__line"><dt>Ongkos kirim</dt><dd data-r-ship>{shippingLabel[plan.area]}</dd></div>
          </dl>
          <div class="ui-nota__tear" aria-hidden="true"></div>
          <div class="ui-nota__total r-total">
            <p class="ui-nota__total-label">Perkiraan total</p>
            <p class="ui-nota__total-value" data-r-total>{formatRupiah(result.total)}</p>
            <p class="r-per tab" data-r-per>{formatRupiah(result.perGuest)} per {first.guestWord}</p>
          </div>
          <NotaDeposit
            rate={terms.depositRate}
            amount={formatRupiah(depositAmount(result.total, terms.depositRate))}
            settlement={settlementText(terms.settlementDays)}
            hidden={!generalTermsApply(result)}
            attrs={{ 'data-r-deposit': true }}
            amountAttrs={{ 'data-r-dp': true }}
            settlementAttrs={{ 'data-r-settle': true }}
          />
          <p class="r-lead" data-r-lead>
            Pesan paling lambat H-{result.leadDays}. Tanggal paling cepat: {formatDateLong(result.earliest)}.
          </p>
          <div class="r-actions">
            <button type="button" class="ui-btn ui-btn--primary r-send" data-send><Icon name="chat" />Kirim ke WhatsApp</button>
            <div class="r-small">
              <button type="button" class="ui-link r-link" data-share>Salin tautan</button>
              <button type="button" class="ui-link r-link" data-print>Cetak</button>
              <button type="button" class="ui-link r-link" data-reset>Mulai ulang</button>
            </div>
          </div>
          <p class="r-note">Perkiraan dari situs. Total akhir dikonfirmasi tim kami lewat WhatsApp.</p>
          <p class="sr-only" aria-live="polite" data-live></p>
        </div>
      </aside>
    </div>
  </section>

  <StickyOrderBar
    total={formatRupiah(result.total)}
    sub={`${formatRupiah(result.perGuest)}/${first.guestWord}`}
    action={{ href: '#nota', label: 'Lihat nota' }}
    class="dock"
    attrs={{ 'data-dock': true, hidden: true }}
    totalAttrs={{ 'data-dock-total': true }}
    subAttrs={{ 'data-dock-per': true }}
  />

  <template id="item-tpl"><ItemRow item={blank} catalog={catalog} /></template>
  <script type="application/json" id="calc-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import '../scripts/calculator';
</script>

<style>
  /* Kalkulator (brand book §8 recipe): presets as EventTiles → line items → Nota → WhatsApp and
     print. The form's steps sit on kraft cards. */
  .head-grid {
    display: grid;
    gap: var(--spacing-3);
    padding-block: var(--spacing-4);
  }
  /* The reveal mask leaves room above (Fraunces ascenders) and below (descenders). */
  .c-title .intro-line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.1em;
    margin-block: -0.12em -0.1em;
  }
  .c-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  .c-title .intro-line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .head-lead {
    max-width: 40ch;
  }

  .app {
    padding-bottom: var(--section-space);
  }
  .noscript {
    padding-block: var(--spacing-3);
  }
  .app-grid {
    display: grid;
    gap: var(--spacing-4);
    align-items: start;
  }
  .controls {
    display: grid;
    gap: var(--spacing-3);
    min-width: 0;
  }
  /* Each step of the form sits on the kraft order zone. */
  .block {
    display: grid;
    gap: var(--spacing-2);
    min-width: 0;
    margin: 0;
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-kraft);
  }
  .controls :global(.step) {
    padding: 0;
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  legend.step {
    float: left;
    width: 100%;
    margin-bottom: var(--spacing-2);
  }
  legend.step + * {
    clear: both;
  }
  .logistics :global(legend.step) {
    float: none;
    margin-bottom: 0;
  }

  /* Presets: radio EventTiles (no photos; the tile spec has none). */
  .preset-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .preset-list :global(.ui-tile) {
    min-height: 112px;
    padding: 14px;
  }
  .status {
    min-height: 1.4em;
    font-size: 14px;
  }
  .status:empty {
    display: none;
  }
  .status :global(button) {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .guest-row {
    display: grid;
    gap: var(--spacing-2);
    align-items: center;
  }
  /* The slider is not one of the brand book's components (flagged); it uses ink. */
  .range {
    width: 100%;
    min-height: var(--tap-min);
    accent-color: var(--color-ink);
  }

  .items-head {
    display: grid;
    gap: 4px;
  }
  .items-hint {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .items {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .items :global(.item) {
    display: grid;
    gap: var(--spacing-2);
    padding: var(--spacing-2);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .items :global(.item.is-new) {
    animation: item-in 200ms var(--ease-out) both;
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .items :global(.item-top) {
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
  }
  .items :global(.item-label) {
    flex: 1;
    min-width: 0;
    height: var(--tap-min);
    padding: 0 10px;
    margin-left: -10px;
    border: 1px solid transparent;
    border-radius: var(--radius-input);
    background: transparent;
    color: var(--color-ink);
    font: 700 17px/1.3 var(--font-sans);
  }
  .items :global(.item-label:hover),
  .items :global(.item-label:focus-visible) {
    border-color: var(--color-ink);
    background: var(--color-card);
  }
  .items :global(.item-grid) {
    display: grid;
    gap: 12px;
  }
  .items :global(.f[hidden]) {
    display: none;
  }
  .items :global(.qty-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-1) 12px;
  }
  .items :global(.per[hidden]),
  .items :global(.fixed[hidden]) {
    display: none;
  }
  .items :global(.per .ui-input) {
    width: auto;
    min-width: 160px;
  }
  .items :global(.qty-out) {
    font: 600 14px/1.3 var(--font-mono);
  }
  .items :global(.item-note) {
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .items :global(.item-note:empty) {
    display: none;
  }
  .items :global(.item-note.warn) {
    color: var(--color-chili);
    font-weight: 600;
  }
  .empty {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .add {
    justify-self: start;
  }

  .logistics {
    gap: var(--spacing-3);
  }
  .help:global(.warn) {
    color: var(--color-chili);
    font-weight: 600;
  }

  /* The Nota */
  .side {
    min-width: 0;
  }
  .r-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--spacing-2);
  }
  .r-mark {
    width: 36px;
    height: 36px;
    flex: none;
  }
  .r-event {
    margin-top: 4px;
    font: 700 20px/1.3 var(--font-sans);
  }
  .r-meta dd {
    font-family: var(--font-sans);
    text-align: right;
    white-space: normal;
  }
  .r-meta {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .lines {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .lines :global(.line) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    font-size: 14px;
  }
  .lines :global(.line.is-new) {
    animation: item-in 200ms var(--ease-out) both;
  }
  .lines :global(.l-name) {
    font-weight: 600;
  }
  .lines :global(.l-amt) {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .lines :global(.l-detail) {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .lines :global(.l-extra) {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-chili);
  }
  .r-empty {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .r-sums {
    padding-top: 10px;
    border-top: 1px solid var(--color-rule-soft);
  }
  .r-per {
    flex-basis: 100%;
    margin: 0;
    text-align: right;
    font: 400 13px/1.3 var(--font-mono);
    color: var(--color-ink-muted);
  }
  .r-lead,
  .r-note {
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .r-actions {
    display: grid;
    gap: 12px;
  }
  .r-send {
    width: 100%;
  }
  .r-small {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--spacing-3);
  }
  .r-link {
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Phones: the sticky order bar follows until the nota is on screen, and steps aside while
     the keyboard is up. */
  :global(.dock) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  :global(.dock[data-off='true']) {
    transform: translateY(110%);
  }
  @media (max-width: 1023px) {
    /* Typing raises the keyboard; preset tiles, area pills and the slider do not. */
    :global(html:has([data-calc-form] input:not([type='radio'], [type='range'], [type='checkbox']):focus) .dock) {
      transform: translateY(110%);
    }
  }
  :global(html.has-dock) {
    scroll-padding-bottom: 96px;
  }

  @media (min-width: 640px) {
    .preset-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .guest-row {
      grid-template-columns: auto 1fr;
      gap: var(--spacing-3);
    }
    .items :global(.item-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .items :global(.f-wide) {
      grid-column: 1 / -1;
    }
    .logistics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: end;
      gap: var(--spacing-5);
    }
    .app-grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 440px);
      gap: var(--spacing-4);
    }
    /* The nota stays in view while the form scrolls, when it fits the screen. */
    .side:global(.fits) {
      position: sticky;
      top: 97px;
    }
  }

  @media print {
    :global(.nav),
    :global(footer),
    :global(.closing),
    :global(.skip),
    .head,
    .controls,
    :global(.dock),
    .r-actions,
    .noscript {
      display: none !important;
    }
    :global(body),
    .app {
      background: var(--color-card) !important;
    }
    :global(main) {
      padding-top: 0;
    }
    .app-grid {
      display: block;
    }
    .side {
      position: static;
    }
    .receipt {
      border: 0;
      padding: 0;
    }
  }
</style>
