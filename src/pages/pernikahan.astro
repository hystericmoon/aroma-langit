---
import Base from '../layouts/Base.astro';
import Figure from '../components/ui/Figure.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import PriceRow from '../components/ui/PriceRow.astro';
import Chip from '../components/ui/Chip.astro';
import Icon from '../components/ui/Icon.astro';
import Terms from '../components/Terms.astro';
import { photos } from '../data/photos';
import { getSite } from '../lib/content';
import { formatRupiah, formatRupiahShort } from '../lib/order';
import { waLink } from '../data/site';
import { weddingCatering, weddingCuisines, weddingBundles, engagementPackages, foodStalls, weddingTerms, weddingPortions } from '../data/wedding';

const site = await getSite();
const start = 500;
const p0 = weddingPortions(start);
---

<Base
  title="Katering pernikahan di Bogor"
  description="Paket katering pernikahan Aroma Langit untuk 100 sampai 1.000 tamu: Platinum, Gold, Silver dan Bronze mulai Rp45.000 per pax, menu Nusantara, Oriental dan Western, plus paket lamaran dan akad."
>
  <section class="head field-navy on-navy" aria-labelledby="w-title">
    <div class="wrap head-grid">
      <div class="head-copy">
        <h1 id="w-title" class="t-display w-title">
          <span class="intro-line"><span>Katering</span></span>
          <span class="intro-line"><span>pernikahan</span></span>
        </h1>
        <p class="t-lead lead">
          Dari lamaran, akad sampai resepsi. Menu Nusantara, Oriental atau Western untuk 100 sampai 1.000 tamu, dan food tasting sebelum Anda membayar uang muka.
        </p>
        <div class="actions">
          <a class="ui-btn ui-btn--primary" href="#porsi">Hitung porsi tamu</a>
          <a class="ui-btn ui-btn--secondary" href={waLink(site.marketingPhone, 'Halo Aroma Langit, saya ingin konsultasi katering pernikahan.')} rel="noopener"><Icon name="chat" />Konsultasi via WhatsApp</a>
        </div>
      </div>
      <Figure photo={photos.prasmananMalam} ratio="4/3" class="head-photo" sizes="(min-width: 1024px) 44vw, 100vw" priority widths={[480, 720, 1000]} />
    </div>
  </section>

  <section class="invites" aria-labelledby="pk-title">
    <div class="wrap">
      <SectionHeading
        id="pk-title"
        title="Empat paket resepsi"
        context="Harga per tamu untuk prasmanan lengkap dengan meja saji, dekorasi meja, peralatan saji dan alat makan."
        split
      />
      <ul role="list" class="ui-price-list cards" data-reveal>
        {
          weddingCatering.map((w) => (
            <li class="invite">
              <PriceRow as="div" name={w.name} meta={`Minimum ${w.minOrder} pax`} price={formatRupiah(w.price)} unit="pax" />
              <p class="inv-note">{w.note}</p>
            </li>
          ))
        }
      </ul>
      <div class="cuisines" data-reveal>
        {
          weddingCuisines.map((c) => (
            <div class="cuisine">
              <h3 class="cu-name">{c.name}</h3>
              <p class="cu-items">{c.sample.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="porsi" class="calc" aria-labelledby="calc-title">
    <div class="wrap calc-grid">
      <div class="calc-copy">
        <SectionHeading id="calc-title" title="Hitung porsi tamu" split />
        <p class="t-body measure muted">
          Rumus dari katalog kami: 60% undangan dihitung sebagai porsi prasmanan, dan 40% undangan dikali lima sebagai porsi gubukan, karena tamu biasanya mencicipi beberapa stall.
        </p>
        <p class="t-meta">Ingin menambah snack box atau tumpeng untuk lamaran? <a class="ui-link calc-link" href="/kalkulator/?acara=pernikahan">Susun di kalkulator katering</a>.</p>
      </div>
      <form class="calc-card field-kraft" data-calc data-phone={site.marketingPhone} novalidate>
        <div class="ui-field">
          <label for="inv">Jumlah undangan</label>
          <input id="inv" class="ui-input ui-input--number" type="number" inputmode="numeric" min="0" max="20000" step="10" value={start} data-inv />
          <input type="range" class="range" min="100" max="2000" step="50" value={start} aria-label="Geser jumlah undangan" data-inv-range />
        </div>
        <div class="calc-out tab" aria-live="polite">
          <div><p class="o-num" data-buffet>{p0.buffet.toLocaleString('id-ID')}</p><p class="o-lab">porsi prasmanan</p></div>
          <div><p class="o-num" data-stall>{p0.stall.toLocaleString('id-ID')}</p><p class="o-lab">porsi gubukan</p></div>
        </div>
        <div class="ui-field">
          <label for="wpkg">Paket prasmanan</label>
          <select id="wpkg" class="ui-input" data-wpkg>
            {weddingCatering.map((w, i) => <option value={w.price} selected={i === 1}>{w.name} · {formatRupiah(w.price)}/pax</option>)}
          </select>
        </div>
        <p class="calc-est">Perkiraan prasmanan <strong class="tab" data-est>{formatRupiah(p0.buffet * weddingCatering[1].price)}</strong></p>
        <p class="t-meta calc-note">Belum termasuk gubukan. Harga gubukan mulai Rp10.000 per porsi, tergantung menunya.</p>
        <button type="submit" class="ui-btn ui-btn--primary calc-send">
          Kirim hitungan ini ke marketing
          <Icon name="arrow-right" />
        </button>
      </form>
    </div>
  </section>

  <section class="bundles" aria-labelledby="b-title">
    <div class="wrap b-grid">
      <SectionHeading id="b-title" title="Tidak mau menghitung?" context="Paket bundling untuk 300 tamu sudah mencakup prasmanan dan gubukan." split />
      <ul role="list" class="ui-price-list b-list" data-reveal>
        {weddingBundles.map((b) => <PriceRow name={b.name} meta={`${b.guests} tamu`} price={formatRupiahShort(b.price)} />)}
      </ul>
    </div>
  </section>

  <section class="engage" aria-labelledby="e-title">
    <div class="wrap e-grid">
      <Figure photo={photos.pernikahan} ratio="4/3" class="e-photo" sizes="(min-width: 1024px) 40vw, 100vw" widths={[480, 800]} />
      <div class="e-copy">
        <SectionHeading id="e-title" title="Lamaran dan akad" split />
        <p class="t-body measure muted">Paket lamaran untuk 50 tamu, dari hidangan dan karpet sampai kebaya atau gaun di paket Jasmine. Paket akad dan all-in wedding ada di katalog layanan.</p>
        <ul role="list" class="ui-price-list e-list">
          {engagementPackages.map((e) => <PriceRow name={`Paket ${e.name}`} meta={`${e.guests} tamu`} price={formatRupiahShort(e.price)} />)}
        </ul>
        <div class="downloads">
          {site.weddingCatalogs.map((c) => <a class="ui-link dl" href={c.url} download><Icon name="download" />{c.label} (PDF)</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="events" aria-labelledby="ev-title">
    <div class="wrap">
      <SectionHeading id="ev-title" title="Dari meja saji kami" split />
      <div class="ev-grid">
        <Figure photo={photos.prasmananOutdoor} ratio="3/2" class="ev-big" sizes="(min-width: 1024px) 50vw, 100vw" widths={[480, 720, 1000]} />
        <Figure photo={photos.prasmananTeh} ratio="1/1" sizes="(min-width: 1024px) 25vw, 50vw" widths={[480, 720]} />
        <Figure photo={photos.hidanganFlatlay} ratio="1/1" sizes="(min-width: 1024px) 25vw, 50vw" widths={[480, 720]} />
        <Figure photo={photos.dapurBaki} ratio="1/1" sizes="(min-width: 1024px) 25vw, 50vw" widths={[480, 720]} />
        <Figure photo={photos.korporatBuffet} ratio="1/1" sizes="(min-width: 1024px) 25vw, 50vw" widths={[480, 640]} />
      </div>
      <p class="t-caption ev-cap">Prasmanan dan hidangan Aroma Langit di berbagai acara.</p>
    </div>
  </section>

  <section class="stalls" aria-labelledby="s-title">
    <div class="wrap">
      <SectionHeading id="s-title" title="Gubukan khas" context="Sebagian dari puluhan pilihan stall, harga per porsi. Laksa, asinan dan soto mie Bogor tentu ada." split />
      <ul role="list" class="chips" data-reveal>
        {
          foodStalls.map((f) => (
            <li>
              <Chip variant="outline" class="stall">
                <span>{f.name}</span>
                <span class="tab chip-price">{formatRupiahShort(f.price)}</span>
              </Chip>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Terms items={weddingTerms} title="Syarat pernikahan" />
</Base>

<script>
  import { weddingPortions } from '../data/wedding';
  import { formatRupiah } from '../lib/order';

  const form = document.querySelector<HTMLFormElement>('[data-calc]')!;
  const inv = form.querySelector<HTMLInputElement>('[data-inv]')!;
  const range = form.querySelector<HTMLInputElement>('[data-inv-range]')!;
  const buffetEl = form.querySelector<HTMLElement>('[data-buffet]')!;
  const stallEl = form.querySelector<HTMLElement>('[data-stall]')!;
  const pkg = form.querySelector<HTMLSelectElement>('[data-wpkg]')!;
  const est = form.querySelector<HTMLElement>('[data-est]')!;

  const read = () => Math.max(0, Math.min(20000, Math.floor(Number(inv.value) || 0)));
  function update(fromRange = false) {
    if (fromRange) inv.value = range.value;
    const n = read();
    if (!fromRange) range.value = String(Math.min(2000, Math.max(100, n)));
    const p = weddingPortions(n);
    buffetEl.textContent = p.buffet.toLocaleString('id-ID');
    stallEl.textContent = p.stall.toLocaleString('id-ID');
    est.textContent = formatRupiah(p.buffet * Number(pkg.value));
  }
  inv.addEventListener('input', () => update());
  inv.addEventListener('blur', () => { inv.value = String(read()); update(); });
  range.addEventListener('input', () => update(true));
  pkg.addEventListener('change', () => update());
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const n = read();
    const p = weddingPortions(n);
    const name = pkg.options[pkg.selectedIndex].text;
    const msg = [
      'Halo Aroma Langit, saya ingin konsultasi katering pernikahan.',
      '',
      `• Jumlah undangan: ${n.toLocaleString('id-ID')}`,
      `• Porsi prasmanan: ${p.buffet.toLocaleString('id-ID')}`,
      `• Porsi gubukan: ${p.stall.toLocaleString('id-ID')}`,
      `• Paket yang diminati: ${name}`,
      '',
      'Mohon info ketersediaan tanggal dan jadwal food tasting. Terima kasih.',
    ].join('\n');
    const url = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(msg)}`;
    const w = window.open(url, '_blank', 'noopener');
    if (!w) window.location.href = url;
  });
  update();
</script>

<style>
  /* Pernikahan (brand book §7 recipe): almost entirely read mode, a navy hero band, large
     Newsreader headings and photos, with an order-mode portion calculator. */
  .head-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-5);
  }
  .head-copy {
    display: grid;
    gap: var(--spacing-3);
    align-content: center;
  }
  .w-title .intro-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .w-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  .w-title .intro-line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .lead {
    max-width: 38ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .invites,
  .calc,
  .bundles,
  .engage,
  .events,
  .stalls {
    padding-block: var(--section-space) 0;
  }
  .stalls {
    padding-bottom: var(--section-space);
  }
  .cards {
    margin-top: var(--spacing-3);
  }
  .invite {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .invite :global(.ui-price-row) {
    border-bottom: 0;
    padding-bottom: 4px;
  }
  .inv-note {
    max-width: 62ch;
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .cuisines {
    display: grid;
    gap: var(--spacing-3);
    margin-top: var(--spacing-4);
  }
  .cu-name {
    font: 400 22px/1.2 var(--font-display);
  }
  .cu-items {
    margin-top: 4px;
    font-size: 15px;
    color: var(--color-ink-muted);
  }
  .muted {
    color: var(--color-ink-muted);
  }

  .calc-grid {
    display: grid;
    gap: var(--spacing-4);
    align-items: start;
  }
  .calc-copy {
    display: grid;
    gap: var(--spacing-2);
  }
  /* Order mode: the portion calculator on the kraft order zone */
  .calc-card {
    display: grid;
    gap: var(--spacing-3);
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
  }
  /* The slider is not one of the brand book's components (flagged); it uses ink. */
  .range {
    width: 100%;
    min-height: var(--tap-min);
    accent-color: var(--color-ink);
  }
  .calc-out {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .calc-out > div {
    padding: var(--spacing-2);
    border: var(--hairline);
    border-radius: var(--radius-input);
    background: var(--color-card);
  }
  .o-num {
    font: 600 22px/1.2 var(--font-mono);
  }
  .o-lab {
    margin-top: 2px;
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .calc-est {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-weight: 600;
  }
  .calc-est strong {
    font: 600 18px/1.3 var(--font-mono);
  }
  .calc-send {
    width: 100%;
  }

  .b-grid {
    display: grid;
    gap: var(--spacing-3);
  }

  .e-grid {
    display: grid;
    gap: var(--spacing-4);
    align-items: start;
  }
  .e-copy {
    display: grid;
    gap: var(--spacing-2);
  }
  .downloads {
    display: grid;
    gap: 4px;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    min-height: var(--tap-min);
  }

  .ev-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: var(--spacing-3);
  }
  .ev-grid :global(.ev-big) {
    grid-column: 1 / -1;
  }
  .ev-cap {
    margin-top: 10px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1);
    margin-top: var(--spacing-3);
  }
  .chips :global(.stall) {
    gap: 8px;
    font-size: 13px;
  }
  .chip-price {
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .cuisines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--spacing-5);
      align-items: center;
    }
    .calc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 480px);
      gap: var(--spacing-5);
    }
    .b-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--spacing-5);
    }
    .e-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--spacing-5);
    }
    .ev-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ev-grid :global(.ev-big) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .ev-grid :global(.ev-big .ui-figure__img) {
      height: 100%;
    }
  }
</style>
