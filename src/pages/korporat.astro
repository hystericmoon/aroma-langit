---
import Base from '../layouts/Base.astro';
import Figure from '../components/ui/Figure.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TrustStamps from '../components/ui/TrustStamps.astro';
import Coupon from '../components/Coupon.astro';
import { photos } from '../data/photos';
import { getServices, getSite } from '../lib/content';
import { formatRupiah } from '../lib/order';

const site = await getSite();
const services = await getServices();
const bySlug = (slug: string) => services.find((s) => s.slug === slug);
const from = (slug: string) => {
  const s = bySlug(slug);
  return s ? formatRupiah(Math.min(...s.packages.map((p) => p.price))) : '';
};
const snackLead = bySlug('snack-box')?.leadDays;
const nutritionist = site.team.find((t) => t.role === 'COO');

const uses = [
  {
    title: 'Makan siang harian',
    text: 'Nasi box atau prasmanan untuk kantin, diantar setiap hari kerja. Menu bisa diatur bergilir dan disusun bersama ahli gizi kami.',
    photo: photos.korporatBuffet,
    links: [{ href: '/katering/nasi-box/', label: `Nasi Box, mulai ${from('nasi-box')}` }, { href: '/katering/prasmanan/', label: `Prasmanan, mulai ${from('prasmanan')}` }],
  },
  {
    title: 'Rapat dan pelatihan',
    text: `Bento dan snack box yang rapi di meja rapat dan ruang pelatihan.${snackLead ? ` Snack box bisa dipesan paling lambat H-${snackLead}.` : ''}`,
    photo: photos.bentoNasgor,
    links: [{ href: '/katering/bento/', label: `Bento, mulai ${from('bento')}` }, { href: '/katering/snack-box/', label: `Snack Box, mulai ${from('snack-box')}` }],
  },
  {
    title: 'Syukuran dan acara kantor',
    text: 'Tumpeng untuk ulang tahun perusahaan, prasmanan dengan gubukan untuk gathering, lengkap dengan meja saji dan pramusaji.',
    photo: photos.tumpeng,
    links: [{ href: '/katering/tumpeng/', label: `Tumpeng, mulai ${from('tumpeng')}` }, { href: '/katering/tumpeng-mini/', label: `Tumpeng Mini, mulai ${from('tumpeng-mini')}` }],
  },
];
---

<Base
  title="Katering kantor dan perusahaan di Bogor"
  description="Katering harian untuk kantor, pabrik dan sekolah di Bogor: makan siang, rapat, pelatihan dan acara perusahaan. Dapur bersertifikat halal BPJPH dan laik higiene, menu disusun ahli gizi."
>
  <section class="head" aria-labelledby="k-title">
    <div class="wrap head-grid">
      <div class="head-copy">
        <h1 id="k-title" class="t-display k-title">
          <span class="intro-line"><span>Katering</span></span>
          <span class="intro-line"><span>kantor</span></span>
        </h1>
        <p class="t-lead lead">
          Makan siang harian, rapat dan acara untuk perusahaan, pabrik dan sekolah. Dimasak di dapur bersertifikat halal dan laik higiene, dengan menu yang disusun ahli gizi.
        </p>
        <div class="actions">
          <a class="ui-btn ui-btn--primary" href="#kupon">Minta penawaran</a>
          <a class="ui-link ui-link--tap ph" href="/kalkulator/?acara=rapat">Hitung kebutuhan rapat</a>
        </div>
      </div>
      <Figure photo={photos.dapurBaki} ratio="4/3" class="head-photo" sizes="(min-width: 1024px) 44vw, 100vw" priority widths={[480, 720, 1080, 1440]} />
    </div>
  </section>

  <section class="uses" aria-labelledby="u-title">
    <div class="wrap">
      <SectionHeading id="u-title" title="Untuk setiap jam di kantor" split />
      <ul role="list" class="u-list">
        {
          uses.map((u, i) => (
            <li class:list={['use', i % 2 && 'flip']} data-reveal>
              <Figure photo={u.photo} ratio="3/2" class="u-photo" sizes="(min-width: 1024px) 42vw, 100vw" widths={[480, 720, 960]} />
              <div class="u-copy">
                <h3 class="u-title">{u.title}</h3>
                <p class="t-body measure u-text">{u.text}</p>
                <ul role="list" class="u-links">
                  {u.links.map((l) => (
                    <li>
                      <a class="ui-link" href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="why" aria-labelledby="y-title">
    <div class="wrap">
      <SectionHeading id="y-title" title="Untuk bagian pengadaan" split />
      <div class="y-cards" data-reveal>
        <div class="y-card wide">
          <TrustStamps />
        </div>
        <dl class="y-card">
          <dt>Badan usaha</dt>
          <dd>{site.legalName}</dd>
        </dl>
        {nutritionist && (
          <dl class="y-card">
            <dt>Ahli gizi</dt>
            <dd>{nutritionist.name}, {nutritionist.role}</dd>
          </dl>
        )}
        <dl class="y-card wide">
          <dt>Pernah melayani</dt>
          <dd class="clients">{site.clients.join(' · ')}</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="form rule-top" aria-labelledby="kupon-title">
    <div class="wrap">
      <Coupon id="kupon" />
    </div>
  </section>
</Base>

<style>
  /* Korporat (brand book §8 recipe): the procurement panel as cards (certificates as trust
     stamps, legal entity, nutritionist, clients) and the quote request. Invoicing details and
     the printable quote Nota are open items (no data yet; a new feature). */
  .head-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-4) var(--section-space);
  }
  .head-copy {
    display: grid;
    gap: var(--spacing-3);
    align-content: center;
  }
  /* The reveal mask leaves room above (Fraunces ascenders) and below (descenders). */
  .k-title .intro-line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.1em;
    margin-block: -0.12em -0.1em;
  }
  .k-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  .k-title .intro-line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .lead {
    max-width: 36ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2) var(--spacing-3);
  }
  .ph {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .uses,
  .why,
  .form {
    padding-bottom: var(--section-space);
  }
  .u-list {
    display: grid;
    gap: var(--spacing-4);
    margin-top: var(--spacing-3);
  }
  .use {
    display: grid;
    gap: var(--spacing-3);
    align-items: center;
  }
  .u-copy {
    display: grid;
    gap: 12px;
  }
  .u-title {
    font: 700 20px/1.3 var(--font-sans);
  }
  .u-links {
    display: grid;
    gap: 4px;
  }
  .u-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .y-cards {
    display: grid;
    gap: 12px;
    margin-top: var(--spacing-3);
  }
  .y-card {
    margin: 0;
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .y-card dt {
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .y-card dd {
    margin: 6px 0 0;
    font: 700 20px/1.3 var(--font-sans);
  }
  .y-card .clients {
    font: 400 16px/1.5 var(--font-sans);
  }

  @media (min-width: 768px) {
    .y-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .y-card.wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--spacing-5);
      align-items: center;
    }
    .use {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--spacing-5);
    }
    .use.flip :global(.u-photo) {
      order: 2;
    }
  }
</style>
