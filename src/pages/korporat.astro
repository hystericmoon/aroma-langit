---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Coupon from '../components/Coupon.astro';
import { photos } from '../data/photos';
import { getServices, getSite } from '../lib/content';
import { formatRupiah } from '../lib/order';

const site = await getSite();
const services = await getServices();
const bySlug = (slug: string) => services.find((s) => s.slug === slug);
const from = (slug: string) => {
  const s = bySlug(slug);
  return s ? formatRupiah(Math.min(...s.packages.map((p) => p.price))) : '';
};
const nutritionist = site.team.find((t) => t.role === 'COO');

const uses = [
  {
    title: 'Makan siang harian',
    text: 'Nasi box atau prasmanan untuk kantin, diantar setiap hari kerja. Menu bisa diatur bergilir dan disusun bersama ahli gizi kami.',
    photo: photos.korporatBuffet,
    links: [{ href: '/katering/nasi-box/', label: `Nasi Box, mulai ${from('nasi-box')}` }, { href: '/katering/prasmanan/', label: `Prasmanan, mulai ${from('prasmanan')}` }],
  },
  {
    title: 'Rapat dan pelatihan',
    text: 'Bento dan snack box yang rapi di meja rapat dan ruang pelatihan. Snack box bisa dipesan sehari sebelum acara.',
    photo: photos.bentoNasgor,
    links: [{ href: '/katering/bento/', label: `Bento, mulai ${from('bento')}` }, { href: '/katering/snack-box/', label: `Snack Box, mulai ${from('snack-box')}` }],
  },
  {
    title: 'Syukuran dan acara kantor',
    text: 'Tumpeng untuk ulang tahun perusahaan, prasmanan dengan gubukan untuk gathering, lengkap dengan meja saji dan pramusaji.',
    photo: photos.tumpeng,
    links: [{ href: '/katering/tumpeng/', label: `Tumpeng, mulai ${from('tumpeng')}` }, { href: '/katering/tumpeng-mini/', label: `Tumpeng Mini, mulai ${from('tumpeng-mini')}` }],
  },
];
---

<Base
  title="Katering kantor dan perusahaan di Bogor"
  description="Katering harian untuk kantor, pabrik dan sekolah di Bogor: makan siang, rapat, pelatihan dan acara perusahaan. Dapur bersertifikat halal BPJPH dan laik higiene, menu disusun ahli gizi."
>
  <section class="head field-orange" aria-labelledby="k-title">
    <div class="wrap head-grid">
      <div class="head-copy">
        <h1 id="k-title" class="t-display k-title">
          <span class="intro-line"><span>Katering</span></span>
          <span class="intro-line"><span>kantor</span></span>
        </h1>
        <p class="t-lead lead">
          Makan siang harian, rapat dan acara untuk perusahaan, pabrik dan sekolah. Dimasak di dapur bersertifikat halal dan laik higiene, dengan menu yang disusun ahli gizi.
        </p>
        <div class="actions">
          <a class="btn" href="#kupon">Minta penawaran</a>
          <a class="link ph" href="/kalkulator/?acara=rapat">Hitung kebutuhan rapat</a>
        </div>
      </div>
      <figure class="head-photo">
        <Photo photo={photos.dapurBaki} sizes="(min-width: 1024px) 44vw, 100vw" priority widths={[480, 720, 1080, 1440]} />
      </figure>
    </div>
  </section>

  <section class="uses field-paper" aria-labelledby="u-title">
    <div class="wrap">
      <h2 id="u-title" class="t-h2" data-split>Untuk setiap jam di kantor</h2>
      <ul role="list" class="u-list">
        {
          uses.map((u, i) => (
            <li class:list={['use', i % 2 && 'flip']} data-reveal>
              <figure class="u-photo">
                <Photo photo={u.photo} sizes="(min-width: 1024px) 42vw, 100vw" widths={[480, 720, 960]} />
              </figure>
              <div class="u-copy">
                <h3 class="u-title">{u.title}</h3>
                <p class="t-body measure">{u.text}</p>
                <ul role="list" class="u-links">
                  {u.links.map((l) => (
                    <li>
                      <a class="link" href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="why field-ink on-dark" aria-labelledby="y-title">
    <div class="wrap y-grid">
      <h2 id="y-title" class="t-h2" data-split>Untuk bagian pengadaan</h2>
      <dl class="y-list" data-reveal>
        <div>
          <dt>Halal BPJPH</dt>
          <dd class="tab">{site.halal.number}</dd>
        </div>
        <div>
          <dt>Laik Higiene Jasaboga {site.hygiene.grade}</dt>
          <dd class="tab">{site.hygiene.number}</dd>
        </div>
        <div>
          <dt>Badan usaha</dt>
          <dd>{site.legalName}</dd>
        </div>
        {nutritionist && (
          <div>
            <dt>Ahli gizi</dt>
            <dd>{nutritionist.name}, {nutritionist.role}</dd>
          </div>
        )}
        <div class="wide">
          <dt>Pernah melayani</dt>
          <dd class="clients">{site.clients.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="form field-paper" aria-labelledby="kupon-title" style="--coupon-ground: var(--paper)">
    <div class="wrap">
      <Coupon id="kupon" />
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(40px, 6vw, 88px) clamp(64px, 8vw, 120px);
  }
  .head-grid {
    display: grid;
    gap: 40px;
  }
  .head-copy {
    display: grid;
    gap: 28px;
    align-content: center;
  }
  .k-title {
    font-size: clamp(3.25rem, 0.8rem + 9vw, 9rem);
  }
  .k-title .intro-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
  }
  .k-title .intro-line > span {
    display: block;
    animation: rise 1100ms var(--ease-out) both;
  }
  .k-title .intro-line:nth-child(2) > span {
    animation-delay: 110ms;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  .lead {
    max-width: 36ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }
  .ph {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }
  .head-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink);
  }
  .head-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .uses,
  .why,
  .form {
    padding-block: var(--section);
  }
  .u-list {
    display: grid;
    gap: clamp(56px, 8vw, 120px);
    margin-top: clamp(40px, 6vw, 88px);
  }
  .use {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .u-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-2);
  }
  .u-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .u-copy {
    display: grid;
    gap: 16px;
  }
  .u-title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .u-links {
    display: grid;
    gap: 2px;
  }
  .u-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .y-grid {
    display: grid;
    gap: 40px;
  }
  .y-grid h2 {
    max-width: 14ch;
  }
  .y-list {
    display: grid;
    gap: 2px;
  }
  .y-list div {
    padding: 20px 24px;
    background: var(--ink-2);
  }
  .y-list dt {
    font-size: var(--step-small);
    font-weight: 700;
    color: var(--peach);
  }
  .y-list dd {
    margin-top: 4px;
    font-size: 1.25rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }
  .y-list .clients {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    .y-list {
      grid-template-columns: 1fr 1fr;
    }
    .y-list .wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .head-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: clamp(40px, 5vw, 96px);
    }
    .use {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 6vw, 120px);
    }
    .use.flip .u-photo {
      order: 2;
    }
    .use.flip {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .y-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 6vw, 120px);
    }
  }
</style>
