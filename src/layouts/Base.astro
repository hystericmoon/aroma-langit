---
import '../styles/global.css';
import '../styles/ui.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getServices, getSite } from '../lib/content';
import { isStaging } from '../lib/siteEnv';

interface Props {
  title: string;
  description: string;
  /** Path of a social image under /public. */
  image?: string;
  closing?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = '/og.jpg', closing = true, schema = [], noindex = false } = Astro.props;
const site = await getSite();
const services = await getServices();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const fullTitle = title.includes('Aroma Langit') ? title : `${title} · Aroma Langit`;
const prices = services.flatMap((s) => s.packages.map((p) => p.price));

const business = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  '@id': `${Astro.site}#business`,
  name: site.brand,
  legalName: site.legalName,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: ogImage,
  email: site.email,
  telephone: `+${site.csPhone}`,
  servesCuisine: ['Indonesia', 'Nusantara', 'Oriental'],
  priceRange: `Rp${Math.min(...prices).toLocaleString('id-ID')}–Rp${Math.max(...prices).toLocaleString('id-ID')}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.office.lines.slice(0, 2).join(', '),
    addressLocality: 'Kota Bogor',
    addressRegion: 'Jawa Barat',
    addressCountry: 'ID',
  },
  areaServed: 'Kota Bogor',
  sameAs: site.socials.map((s) => s.url),
  hasMenu: new URL('/#menu', Astro.site).href,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isStaging) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#faf6ef" />
    <noscript>
      <style>
        /* Without JavaScript every tab panel shows, so no price or menu is out of reach. */
        [data-tabs] > [role='tablist'] { display: none !important; }
        [data-tabs] [role='tabpanel'][hidden] { display: block !important; }
      </style>
    </noscript>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Aroma Langit" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify([business, ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Langsung ke isi</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer closing={closing} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    padding-top: 73px; /* fixed header: 72px bar + 1px hairline */
    outline: none;
  }
</style>
