---
import { full, mark } from '../assets/brand/logo-paths';

interface Props {
  variant?: 'full' | 'mark' | 'wordmark' | 'lockup';
  /** color: brand colours on paper. on-orange: paper and ink, for the orange ground. ink: single ink. */
  tone?: 'color' | 'on-orange' | 'on-ink' | 'ink';
  class?: string;
  title?: string;
}

const { variant = 'full', tone = 'color', class: cls, title = 'Aroma Langit' } = Astro.props;
const art = variant === 'mark' ? mark : full;
const viewBox = variant === 'wordmark' ? '0 2540 3000 531' : art.viewBox;
// An empty title marks the logo as decoration next to text that already names it.
const a11y: Record<string, string> = title ? { role: 'img', 'aria-label': title } : { 'aria-hidden': 'true' };
const fills = {
  // The logo's own brown is not a brand-book colour, so the two-colour version uses ink.
  color: ['var(--color-orange)', 'var(--color-ink)'],
  'on-orange': ['var(--color-paper)', 'var(--color-ink)'],
  'on-ink': ['var(--color-orange)', 'var(--color-paper)'],
  ink: ['var(--color-ink)', 'var(--color-ink)'],
}[tone];
---

{
  variant === 'lockup' ? (
    <span class:list={['lockup', cls]} {...a11y}>
      <svg class="lockup-mark" viewBox={mark.viewBox} aria-hidden="true" focusable="false">
        <path fill={fills[0]} d={mark.orange} />
        <path fill={fills[1]} d={mark.brown} />
      </svg>
      <svg class="lockup-word" viewBox="0 2540 3000 531" aria-hidden="true" focusable="false">
        <path fill={fills[0]} d={full.orange} />
        <path fill={fills[1]} d={full.brown} />
      </svg>
    </span>
  ) : (
    <svg class:list={['logo', cls]} viewBox={viewBox} {...a11y} focusable="false">
      <path fill={fills[0]} d={art.orange} />
      <path fill={fills[1]} d={art.brown} />
    </svg>
  )
}

<style>
  .logo {
    display: block;
    height: auto;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    font-size: 40px;
    height: 1em;
  }
  .lockup-mark {
    height: 1em;
    width: 1em;
    flex: none;
  }
  .lockup-word {
    height: 0.52em;
    width: auto;
    aspect-ratio: 3000 / 531;
    margin-top: 0.12em;
  }
</style>
