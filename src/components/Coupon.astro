---
import { getSite } from '../lib/content';
import Icon from './ui/Icon.astro';

interface Props {
  headingLevel?: 'h2' | 'h3';
  id?: string;
}
const { headingLevel = 'h2', id = 'kantor' } = Astro.props;
const H = headingLevel;
const site = await getSite();
---

<div class="coupon-wrap" id={id}>
  <form class="coupon" action="/api/penawaran" method="post" data-coupon data-phone={site.marketingPhone} novalidate>
    <div class="left">
      <H class="c-title" id={`${id}-title`}>Makan siang kantor.</H>
      <p class="c-text">
        Katering harian untuk kantor, pabrik dan sekolah, dengan menu bergilir yang disusun ahli gizi kami. Isi kupon ini, tim marketing akan menghubungi Anda lewat WhatsApp.
      </p>
    </div>
    <div class="right">
      <div class="inputs">
        <div class="ui-field">
          <label for={`${id}-nama`}>Nama Anda</label>
          <input id={`${id}-nama`} class="ui-input" name="nama" autocomplete="name" autocapitalize="words" enterkeyhint="next" placeholder="Nama Anda" required maxlength="80" />
        </div>
        <div class="ui-field">
          <label for={`${id}-perusahaan`}>Perusahaan atau instansi</label>
          <input id={`${id}-perusahaan`} class="ui-input" name="perusahaan" autocomplete="organization" autocapitalize="words" enterkeyhint="next" placeholder="Perusahaan atau instansi" required maxlength="120" />
        </div>
        <div class="ui-field">
          <label for={`${id}-whatsapp`}>Nomor WhatsApp</label>
          <input id={`${id}-whatsapp`} class="ui-input" name="whatsapp" type="tel" enterkeyhint="next" inputmode="tel" autocomplete="tel" placeholder="Nomor WhatsApp" required maxlength="20" pattern="[0-9+\-\s]{8,20}" />
        </div>
        <div class="ui-field">
          <label for={`${id}-porsi`}>Perkiraan porsi per hari</label>
          <input id={`${id}-porsi`} class="ui-input ui-input--number" name="porsi" type="number" enterkeyhint="send" inputmode="numeric" min="1" max="100000" placeholder="Perkiraan porsi per hari" required />
        </div>
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </div>
      <p class="c-status" role="status" data-coupon-status></p>
      <button type="submit" class="ui-btn ui-btn--primary submit">
        <span data-coupon-label>Minta penawaran</span>
        <Icon name="arrow-right" />
      </button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-coupon]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-coupon-status]')!;
    const label = form.querySelector<HTMLElement>('[data-coupon-label]')!;
    const phone = form.dataset.phone!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
      const bad = fields.find((f) => !f.checkValidity() || !f.value.trim());
      fields.forEach((f) => f.setAttribute('aria-invalid', String(!f.checkValidity() || !f.value.trim())));
      if (bad) {
        status.textContent =
          bad.name === 'whatsapp'
            ? 'Nomor WhatsApp belum benar. Gunakan angka, minimal 8 digit.'
            : bad.name === 'porsi' && bad.value.trim()
              ? 'Isi perkiraan porsi dengan angka bulat, misalnya 150.'
              : `Lengkapi isian "${bad.placeholder}".`;
        bad.focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      data.porsi = String(Math.floor(Number(data.porsi))); // "1e3" → "1000"

      const msg = [
        'Halo Aroma Langit, saya ingin penawaran katering kantor:',
        '',
        `• Nama: ${data.nama}`,
        `• Perusahaan: ${data.perusahaan}`,
        `• WhatsApp: ${data.whatsapp}`,
        `• Perkiraan porsi per hari: ${data.porsi}`,
      ].join('\n');
      const wa = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
      label.textContent = 'Mengirim…';
      form.setAttribute('aria-busy', 'true');
      let sent = false;
      try {
        const ctrl = new AbortController();
        const t = window.setTimeout(() => ctrl.abort(), 6000);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
          signal: ctrl.signal,
        });
        clearTimeout(t);
        sent = res.ok && (await res.json().catch(() => ({}))).ok === true;
      } catch {
        sent = false;
      }
      form.removeAttribute('aria-busy');
      if (sent) {
        form.reset();
        label.textContent = 'Terkirim';
        status.innerHTML = '';
        status.append('Terima kasih. Tim marketing kami akan menghubungi Anda lewat WhatsApp. ');
        const a = document.createElement('a');
        a.href = wa;
        a.rel = 'noopener';
        a.target = '_blank';
        a.textContent = 'Atau lanjutkan chat sekarang.';
        status.append(a);
      } else {
        label.textContent = 'Minta penawaran';
        status.textContent = 'Kami membuka WhatsApp marketing dengan isian Anda.';
        const w = window.open(wa, '_blank', 'noopener');
        if (!w) window.location.href = wa;
      }
    });
  });
</script>

<style>
  /* Quote request: order mode. Fields and the primary button on a card. */
  .coupon {
    display: grid;
    gap: var(--spacing-3);
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .left {
    display: grid;
    gap: var(--spacing-1);
    align-content: start;
  }
  .c-title {
    font: 400 32px/1.1 var(--font-display);
  }
  .c-text {
    max-width: 46ch;
    color: var(--color-ink-muted);
    font-size: 15px;
  }
  .right {
    display: grid;
    gap: var(--spacing-2);
  }
  .inputs {
    display: grid;
    gap: var(--spacing-2);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .c-status {
    font-size: 14px;
  }
  .c-status:empty {
    display: none;
  }
  .c-status :global(a) {
    color: var(--color-orange-ink);
    font-weight: 600;
  }
  .submit {
    justify-self: start;
  }
  @media (min-width: 768px) {
    .inputs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .coupon {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--spacing-5);
      padding: var(--spacing-4);
    }
  }
</style>
