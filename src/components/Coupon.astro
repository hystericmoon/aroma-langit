---
import { getSite } from '../lib/content';

interface Props {
  headingLevel?: 'h2' | 'h3';
  id?: string;
}
const { headingLevel = 'h2', id = 'kantor' } = Astro.props;
const H = headingLevel;
const site = await getSite();
---

<div class="coupon-wrap" id={id}>
  <form class="coupon field-ink on-dark" action="/api/penawaran" method="post" data-coupon data-phone={site.marketingPhone} novalidate>
    <div class="left">
      <H class="c-title" id={`${id}-title`}>Makan siang kantor.</H>
      <p class="c-text">
        Katering harian untuk kantor, pabrik dan sekolah, dengan menu bergilir yang disusun ahli gizi kami. Isi kupon ini, tim marketing akan menghubungi Anda lewat WhatsApp.
      </p>
    </div>
    <div class="perf" aria-hidden="true"></div>
    <div class="right">
      <div class="inputs">
        <label class="in">
          <span class="sr-only">Nama Anda</span>
          <input name="nama" autocomplete="name" placeholder="Nama Anda" required maxlength="80" />
        </label>
        <label class="in">
          <span class="sr-only">Perusahaan atau instansi</span>
          <input name="perusahaan" autocomplete="organization" placeholder="Perusahaan atau instansi" required maxlength="120" />
        </label>
        <label class="in">
          <span class="sr-only">Nomor WhatsApp</span>
          <input name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="Nomor WhatsApp" required maxlength="20" pattern="[0-9+\-\s]{8,20}" />
        </label>
        <label class="in">
          <span class="sr-only">Perkiraan porsi per hari</span>
          <input name="porsi" type="number" inputmode="numeric" min="1" max="100000" placeholder="Perkiraan porsi per hari" required />
        </label>
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </div>
      <p class="c-status t-small" role="status" data-coupon-status></p>
      <button type="submit" class="submit">
        <span data-coupon-label>Minta penawaran</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 10h13M11 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" /></svg>
      </button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-coupon]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-coupon-status]')!;
    const label = form.querySelector<HTMLElement>('[data-coupon-label]')!;
    const phone = form.dataset.phone!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
      const bad = fields.find((f) => !f.checkValidity() || !f.value.trim());
      fields.forEach((f) => f.setAttribute('aria-invalid', String(!f.checkValidity() || !f.value.trim())));
      if (bad) {
        status.textContent = bad.name === 'whatsapp' ? 'Nomor WhatsApp belum benar. Gunakan angka, minimal 8 digit.' : `Lengkapi isian "${bad.placeholder}".`;
        bad.focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const msg = [
        'Halo Aroma Langit, saya ingin penawaran katering kantor:',
        '',
        `• Nama: ${data.nama}`,
        `• Perusahaan: ${data.perusahaan}`,
        `• WhatsApp: ${data.whatsapp}`,
        `• Perkiraan porsi per hari: ${data.porsi}`,
      ].join('\n');
      const wa = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
      label.textContent = 'Mengirim…';
      form.setAttribute('aria-busy', 'true');
      let sent = false;
      try {
        const ctrl = new AbortController();
        const t = window.setTimeout(() => ctrl.abort(), 6000);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
          signal: ctrl.signal,
        });
        clearTimeout(t);
        sent = res.ok && (await res.json().catch(() => ({}))).ok === true;
      } catch {
        sent = false;
      }
      form.removeAttribute('aria-busy');
      if (sent) {
        form.reset();
        label.textContent = 'Terkirim';
        status.innerHTML = '';
        status.append('Terima kasih. Tim marketing kami akan menghubungi Anda lewat WhatsApp. ');
        const a = document.createElement('a');
        a.href = wa;
        a.rel = 'noopener';
        a.target = '_blank';
        a.textContent = 'Atau lanjutkan chat sekarang.';
        status.append(a);
      } else {
        label.textContent = 'Minta penawaran';
        status.textContent = 'Kami membuka WhatsApp marketing dengan isian Anda.';
        const w = window.open(wa, '_blank', 'noopener');
        if (!w) window.location.href = wa;
      }
    });
  });
</script>

<style>
  .coupon-wrap {
    padding-block: 0;
  }
  .coupon {
    position: relative;
    display: grid;
    gap: 0;
  }
  .left {
    display: grid;
    gap: 20px;
    align-content: space-between;
    padding: clamp(28px, 4vw, 56px);
  }
  .c-title {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.98;
    max-width: 11ch;
    text-wrap: balance;
  }
  .c-text {
    max-width: 44ch;
    color: var(--paper);
  }
  /* Perforation, with notches cut by the page ground at both ends */
  .perf {
    position: relative;
    height: 0;
    margin-inline: 28px;
    border-top: 6px dotted var(--coupon-ground, var(--paper));
  }
  .perf::before,
  .perf::after {
    content: '';
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--coupon-ground, var(--paper));
    top: -19px;
  }
  .perf::before {
    left: -44px;
  }
  .perf::after {
    right: -44px;
  }
  .right {
    display: grid;
    gap: 12px;
    align-content: center;
    padding: clamp(28px, 4vw, 56px);
  }
  .inputs {
    display: grid;
    gap: 10px;
  }
  .in input {
    width: 100%;
    min-height: 56px;
    padding: 0 18px;
    border: 0;
    border-radius: 0;
    background: var(--ink-2);
    color: var(--paper);
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .in input::placeholder {
    color: var(--peach);
    opacity: 1;
  }
  .in input:focus-visible {
    outline: 3px solid var(--peach);
    outline-offset: 2px;
  }
  .in input[aria-invalid='true'] {
    outline: 3px solid var(--orange);
    outline-offset: -3px;
  }
  /* Honeypot field, kept off screen (taste-skill-ignore: not a visual rule) */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px; /* taste-skill-ignore */
    height: 1px; /* taste-skill-ignore */
    opacity: 0;
  }
  .c-status {
    min-height: 1.5em;
    color: var(--peach);
  }
  .c-status :global(a) {
    color: var(--paper);
  }
  .submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 0 22px;
    border: 0;
    background: var(--orange);
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 800;
    cursor: pointer;
    transition: background var(--dur) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .submit:hover {
    background: #f59a45;
  }
  .submit:active {
    transform: scale(0.98);
  }
  .submit svg {
    transition: transform var(--dur) var(--ease-out);
  }
  .submit:hover svg {
    transform: translateX(4px);
  }
  .coupon[aria-busy='true'] .submit {
    opacity: 0.7;
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .coupon {
      grid-template-columns: minmax(0, 46fr) auto minmax(0, 54fr);
    }
    .perf {
      width: 0;
      height: auto;
      margin: 28px 0;
      border-top: 0;
      border-left: 6px dotted var(--coupon-ground, var(--paper));
    }
    .perf::before,
    .perf::after {
      left: -19px;
      right: auto;
    }
    .perf::before {
      top: -44px;
    }
    .perf::after {
      top: auto;
      bottom: -44px;
    }
  }
</style>
