---
import type { Package } from '../data/types';
import { formatRupiah } from '../lib/order';
import Tabs from './ui/Tabs.astro';
import Icon from './ui/Icon.astro';

interface Props {
  pkg: Package;
  serviceSlug: string;
  serviceTitle: string;
  index: number;
}
const { pkg, serviceSlug, serviceTitle, index } = Astro.props;
const uid = `${serviceSlug}-${pkg.id}`;
// Set menus (bento, snack box) list each set; pick-one menus get tabs.
const isSetMenu = pkg.variants.every((v) => v.groups.length === 1 && v.groups[0].label === 'Isi');
const meta = [pkg.minOrder > 1 ? `Minimum ${pkg.minOrder} ${pkg.unit}` : '', pkg.note ?? ''].filter(Boolean).join(' · ');
---

<article class="pkg" data-index={index} aria-labelledby={`${uid}-name`}>
  <div class="pkg-side">
    <header class="ui-price-row pkg-head">
      <div class="ui-price-row__name">
        <h3 id={`${uid}-name`} class="t-item-name">{serviceTitle} {pkg.name}</h3>
        {meta && <small>{meta}</small>}
      </div>
      <p class="ui-price-row__price tab">
        {formatRupiah(pkg.price)}<span class="ui-price-row__unit">/{pkg.unit}</span>
      </p>
    </header>
    <a class="ui-btn ui-btn--secondary ui-btn--small use" href={`/?layanan=${serviceSlug}&paket=${pkg.id}#pesan`}>
      Pakai paket ini
      <Icon name="arrow-right" />
    </a>
  </div>
  <div class="pkg-main">
    {
      isSetMenu ? (
        <ul role="list" class="sets">
          {pkg.variants.map((v) => (
            <li class="set">
              <h4 class="set-name">{v.name}</h4>
              <p class="set-items">{v.groups[0].items.join(' · ')}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="menus" data-tabs>
          {pkg.variants.length > 1 && (
            <Tabs
              label={`Pilihan menu ${pkg.name}`}
              class="vtabs"
              tabs={pkg.variants.map((v, i) => ({ id: `${uid}-t${i}`, label: v.name, controls: `${uid}-p${i}` }))}
            />
          )}
          {pkg.variants.map((v, i) => (
            <div
              class="vpanel"
              role={pkg.variants.length > 1 ? 'tabpanel' : undefined}
              id={`${uid}-p${i}`}
              aria-labelledby={pkg.variants.length > 1 ? `${uid}-t${i}` : undefined}
              hidden={i !== 0}
            >
              <dl class="groups">
                {v.groups.map((g) => (
                  <div class="grp">
                    <dt>{g.label}</dt>
                    <dd>{g.items.join(' · ')}</dd>
                  </div>
                ))}
              </dl>
              {v.extras && v.extras.length > 0 && <p class="extras t-meta">Termasuk {v.extras.join(', ').toLowerCase()}.</p>}
            </div>
          ))}
          {pkg.variants.some((v) => v.groups.some((g) => g.items.length > 1)) && (
            <p class="t-meta">Pilih satu hidangan dari setiap baris.</p>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  /* A package on a white card: name, mono price and the order action, with its menu in menu
     Tabs beside it (brand book §8). */
  .pkg {
    display: grid;
    gap: var(--spacing-3);
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .pkg-side {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }
  .pkg-head {
    width: 100%;
    padding: 0;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .pkg-head h3 {
    margin: 0;
    font-size: 20px;
  }
  .pkg-main {
    min-width: 0;
  }
  .menus {
    display: grid;
    gap: var(--spacing-2);
  }
  .vpanel[hidden] {
    display: none;
  }
  .groups {
    margin: 0;
  }
  .grp {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .grp dt {
    font: 600 14px/1.4 var(--font-sans);
  }
  .grp dd {
    margin: 0;
  }
  .extras {
    margin-top: 10px;
  }
  .sets {
    display: grid;
    gap: 0;
  }
  .set {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .set-name {
    font: 700 16px/1.3 var(--font-sans);
  }
  .set-items {
    margin-top: 2px;
  }
  @media (min-width: 1024px) {
    .pkg {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--spacing-5);
      padding: var(--spacing-4);
    }
  }
</style>
