---
import type { Service } from '../data/types';
import { getSite } from '../lib/content';
import { waLink } from '../data/site';
import SectionHeading from './ui/SectionHeading.astro';

interface Props {
  service?: Service;
  /** Replaces the shared terms entirely (used for weddings). */
  items?: string[];
  title?: string;
}
const { service, items, title = 'Syarat pemesanan' } = Astro.props;
const site = await getSite();
const list = items ?? [
  ...(service
    ? [`${service.title} dipesan paling lambat ${service.leadDays} hari sebelum acara (H-${service.leadDays}).`]
    : []),
  ...site.sharedTerms,
  ...(service?.terms ?? []),
];
---

<section class="terms" aria-labelledby="terms-title">
  <div class="wrap grid-t">
    <div class="t-side">
      <SectionHeading id="terms-title" title={title} context="Supaya pesanan Anda aman dan tepat waktu. Ada yang ingin dirundingkan? Marketing kami siap bantu." split />
      <a class="ui-link ui-link--tap side-link" href={waLink(site.marketingPhone, 'Halo Aroma Langit, saya ingin bertanya tentang syarat pemesanan.')} rel="noopener">
        Tanya marketing via WhatsApp
      </a>
    </div>
    <ul role="list" class="list" data-reveal>
      {list.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Terms list: read mode, rows divided by rule-soft. The wording comes from site data. */
  .terms {
    padding-block: 0 var(--section-space);
  }
  .grid-t {
    display: grid;
    gap: var(--spacing-3);
  }
  .t-side {
    display: grid;
    gap: var(--spacing-2);
    align-content: start;
    justify-items: start;
  }
  .t-side :global(.ui-section-head) {
    width: 100%;
  }
  .list {
    margin: 0;
    padding: 0;
    border-top: var(--hairline);
  }
  .list li {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-rule-soft);
    font-size: 15px;
    line-height: 1.55;
  }
  @media (min-width: 1024px) {
    .grid-t {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--spacing-5);
    }
    .list {
      margin-top: var(--spacing-2);
    }
  }
</style>
