---
import Logo from './Logo.astro';
import Photo from './Photo.astro';
import Icon from './ui/Icon.astro';
import { getServices, getSite } from '../lib/content';
import { formatPhone, waLink } from '../data/site';
import { leadTimeSummary } from '../lib/order';
import { photos } from '../data/photos';

interface Props {
  /** Hide the closing call to action (e.g. on pages that end with their own). */
  closing?: boolean;
}
const { closing = true } = Astro.props;
const site = await getSite();
const services = await getServices();
const year = new Date().getFullYear();
---

{
  closing && (
    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap">
        <div class="closing-inner">
          <h2 id="closing-title" class="t-display closing-title" data-split>Acara Anda tanggal berapa?</h2>
          <div class="closing-side">
            <p class="t-lead">Sebutkan tanggalnya, kami siapkan sisanya. {leadTimeSummary(services)}</p>
            <div class="closing-actions">
              <a class="ui-btn ui-btn--primary" href="/#pesan">Susun pesanan</a>
              <a class="ui-btn ui-btn--secondary" href={waLink(site.csPhone, 'Halo Aroma Langit, saya ingin bertanya tentang katering.')} rel="noopener">
                <Icon name="chat" />
                Tanya via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
<footer class="footer field-navy on-navy" aria-labelledby="footer-title">
  <div class="wrap">
    <div class="foot-grid">
      <div class="note">
        <h2 id="footer-title" class="sign-off">Salam hangat dari dapur kami.</h2>
        <p class="t-body measure">
          Setiap kotak kami masak di Pasir Kuda, Bogor Barat, oleh tim bersertifikat penjamah makanan dan HACCP. Bersertifikat Halal BPJPH dan Laik Higiene Jasaboga {site.hygiene.grade}.
        </p>
        <dl class="certs tab">
          <div>
            <dt>Halal</dt>
            <dd>{site.halal.number}</dd>
          </div>
          <div>
            <dt>Laik Higiene</dt>
            <dd>{site.hygiene.number}</dd>
          </div>
        </dl>
      </div>
      <div class="address">
        <figure class="stamp">
          <Photo photo={photos.dapurKoki} sizes="120px" widths={[240]} position="40% 50%" alt="Juru masak Aroma Langit di dapur" />
        </figure>
        <div class="addr-block">
          <h3 class="addr-h">{site.kitchen.label}</h3>
          <a class="addr-link" href={site.kitchen.mapUrl} rel="noopener">{site.kitchen.lines.join(', ')}</a>
        </div>
        <div class="addr-block">
          <h3 class="addr-h">{site.office.label}</h3>
          <a class="addr-link" href={site.office.mapUrl} rel="noopener">{site.office.lines.join(', ')}</a>
        </div>
        <div class="addr-block">
          <h3 class="addr-h">Hubungi</h3>
          <ul role="list" class="contact">
            <li>
              <a href={waLink(site.csPhone)} rel="noopener">
                <span class="tab">{formatPhone(site.csPhone)}</span> <span class="hint">Layanan pelanggan, {site.csHours}</span>
              </a>
            </li>
            <li>
              <a href={waLink(site.marketingPhone)} rel="noopener">
                <span class="tab">{formatPhone(site.marketingPhone)}</span> <span class="hint">Marketing, {site.marketingHours}</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="foot-nav">
      <nav aria-label="Layanan">
        <ul role="list">
          {services.map((s) => <li><a href={`/katering/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Tautan lain">
        <ul role="list">
          <li><a href="/kalkulator/">Kalkulator katering</a></li>
          <li><a href="/pernikahan/">Pernikahan</a></li>
          <li><a href="/korporat/">Katering kantor</a></li>
          <li><a href="/tentang-kami/">Tentang kami</a></li>
          <li><a href={site.pricelistUrl} download>Daftar harga (PDF)</a></li>
        </ul>
      </nav>
      <nav aria-label="Media sosial">
        <ul role="list">
          {site.socials.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <Logo variant="wordmark" tone="on-ink" class="big-word" title="Aroma Langit" />
    <p class="imprint tab">© {year} {site.legalName}. Halal {site.halal.number}.</p>
  </div>
</footer>

<style>
  /* Closing call to action: read mode on paper */
  .closing {
    padding-block: var(--section-space);
  }
  .closing-inner {
    display: grid;
    gap: var(--spacing-4);
    align-items: end;
    padding-top: var(--spacing-3);
    border-top: var(--rule-double);
  }
  .closing-side {
    display: grid;
    gap: var(--spacing-3);
    max-width: 520px;
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 1024px) {
    .closing-inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  /* Footer: the page's navy, paper text */
  .footer {
    padding-block: var(--spacing-5) var(--spacing-4);
  }
  .foot-grid {
    display: grid;
    gap: var(--spacing-4);
  }
  .note {
    display: grid;
    gap: var(--spacing-2);
    align-content: start;
  }
  .sign-off {
    font: 300 clamp(32px, 1.6rem + 1.4vw, 44px) / 1.05 var(--font-display);
    text-wrap: balance;
  }
  .certs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-4);
    margin: var(--spacing-1) 0 0;
  }
  .certs dt {
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .certs dd {
    margin: 4px 0 0;
    font-size: 14px;
  }
  .address {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
  }
  .stamp {
    width: 96px;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .stamp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .addr-h {
    margin-bottom: 4px;
    font: 600 12px/1.3 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .addr-link {
    display: inline-block;
    padding-block: 10px;
  }
  .addr-link,
  .contact a {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .contact {
    display: grid;
    gap: 6px;
  }
  .contact a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    min-height: var(--tap-min);
  }
  .hint {
    font-size: 13px;
  }
  .foot-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-3);
    margin-top: var(--spacing-5);
    padding-top: var(--spacing-3);
    border-top: 1px solid var(--color-paper);
  }
  .foot-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    color: var(--color-paper);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .foot-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer :global(.big-word) {
    width: 100%;
    height: auto;
    margin-top: var(--spacing-5);
  }
  .imprint {
    margin-top: var(--spacing-2);
    font-size: 13px;
  }
  @media (min-width: 768px) {
    .address {
      grid-template-columns: 96px 1fr 1fr;
      align-items: start;
    }
    .address .addr-block:last-child {
      grid-column: 2 / -1;
    }
    .foot-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .foot-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--spacing-5);
    }
  }
</style>
