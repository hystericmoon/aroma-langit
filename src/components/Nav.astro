---
import Logo from './Logo.astro';
import Icon from './ui/Icon.astro';
import { getServices, getSite } from '../lib/content';
import { formatRupiah } from '../lib/order';
import { waLink } from '../data/site';

const services = await getServices();
const site = await getSite();
const path = Astro.url.pathname;
const from = (s: (typeof services)[number]) => Math.min(...s.packages.map((p) => p.price));
const links = [
  { href: '/kalkulator/', label: 'Kalkulator' },
  { href: '/pernikahan/', label: 'Pernikahan' },
  { href: '/korporat/', label: 'Katering kantor' },
  { href: '/tentang-kami/', label: 'Tentang kami' },
];
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="nav" data-nav data-hidden="false" data-open="false">
  <div class="bar wrap">
    <a href="/" class="home" aria-label="Aroma Langit, ke beranda">
      <Logo variant="lockup" tone="ink" class="nav-logo" title="Aroma Langit" />
    </a>

    <nav class="desk" aria-label="Utama">
      <div class="menu-wrap" data-dropdown>
        <button type="button" class="nav-link menu-btn" aria-expanded="false" aria-controls="menu-panel">
          Menu &amp; harga
          <Icon name="chevron-down" size={16} class="chev" />
        </button>
        <div class="dropdown" id="menu-panel" hidden>
          <ul role="list">
            {
              services.map((s) => (
                <li>
                  <a href={`/katering/${s.slug}/`} aria-current={isCurrent(`/katering/${s.slug}/`) ? 'page' : undefined}>
                    <span class="d-name">{s.title}</span>
                    <span class="d-price tab">mulai {formatRupiah(from(s))}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="d-pdf ui-link ui-link--tap" href={site.pricelistUrl} download>Unduh daftar harga (PDF)</a>
        </div>
      </div>
      {
        links.map((l) => (
          <a class="nav-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="ui-btn ui-btn--secondary ui-btn--small nav-cta" href="/#pesan">Susun pesanan</a>
      <button type="button" class="burger ui-btn ui-btn--secondary ui-btn--icon" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden>
    <div class="wrap mobile-inner">
      <p class="m-head t-eyebrow">Menu &amp; harga</p>
      <ul role="list" class="m-services">
        {
          services.map((s) => (
            <li>
              <a href={`/katering/${s.slug}/`}>
                <span class="m-name">{s.title}</span>
                <span class="m-price tab">mulai {formatRupiah(from(s))}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="m-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="m-actions">
        <a class="ui-btn ui-btn--primary" href="/#pesan">Susun pesanan</a>
        <a class="ui-btn ui-btn--secondary" href={waLink(site.csPhone)} rel="noopener"><Icon name="chat" />Tanya via WhatsApp</a>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('.burger')!;
  const mobile = nav.querySelector<HTMLElement>('#mobile-menu')!;
  const dd = nav.querySelector<HTMLElement>('[data-dropdown]')!;
  const ddBtn = dd.querySelector<HTMLButtonElement>('.menu-btn')!;
  const ddPanel = dd.querySelector<HTMLElement>('.dropdown')!;

  function setMobile(open: boolean, returnFocus = true) {
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    nav.dataset.open = String(open);
    mobile.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
    if (open) {
      window.__lenis?.stop();
      mobile.querySelector<HTMLElement>('a')?.focus();
    } else {
      window.__lenis?.start();
      if (returnFocus) burger.focus();
    }
  }
  burger.addEventListener('click', () => setMobile(burger.getAttribute('aria-expanded') !== 'true'));
  mobile.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMobile(false, false);
  });

  function setDropdown(open: boolean) {
    if (!open) pinned = false;
    ddBtn.setAttribute('aria-expanded', String(open));
    ddPanel.hidden = !open;
    dd.dataset.open = String(open);
  }
  // Hover opens it for mouse users; a click pins it open (or closes it if it was pinned).
  let pinned = false;
  ddBtn.addEventListener('click', () => {
    const open = ddBtn.getAttribute('aria-expanded') === 'true';
    if (open && !pinned) { pinned = true; return; }
    pinned = !open;
    setDropdown(!open);
  });
  let closeTimer = 0;
  if (window.matchMedia('(hover: hover)').matches) {
    dd.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(closeTimer);
      setDropdown(true);
    });
    dd.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || pinned) return;
      closeTimer = window.setTimeout(() => setDropdown(false), 180);
    });
  }
  dd.addEventListener('focusout', (e) => {
    if (!dd.contains(e.relatedTarget as Node)) setDropdown(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (burger.getAttribute('aria-expanded') === 'true') setMobile(false);
    if (ddBtn.getAttribute('aria-expanded') === 'true') { setDropdown(false); ddBtn.focus(); }
  });
  window.matchMedia('(min-width: 1200px)').addEventListener('change', (e) => {
    if (e.matches && burger.getAttribute('aria-expanded') === 'true') setMobile(false, false);
  });
</script>

<style>
  /* Header: read mode. Not one of the brand book's 12 components (flagged); built from its
     tokens: paper bar, ink hairline, Jakarta labels, pill buttons. */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: var(--hairline);
    transition: transform var(--dur-slow) var(--ease-out);
    view-transition-name: site-nav;
  }
  .nav[data-hidden='true'] {
    transform: translateY(-100%);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    height: 72px;
  }
  .home {
    display: block;
    flex: none;
  }
  .nav :global(.nav-logo) {
    font-size: 40px;
  }
  .desk {
    display: none;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap-min);
    padding: 0 12px;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: 600 14px/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav :global(.chev) {
    transition: transform var(--dur) var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] :global(.chev) {
    transform: rotate(180deg);
  }
  .menu-wrap {
    position: relative;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 13px);
    left: 0;
    width: 340px;
    padding: var(--spacing-2) var(--spacing-3) var(--spacing-3);
    background: var(--color-paper);
    border: var(--hairline);
  }
  .dropdown ul {
    margin: 0 0 var(--spacing-2);
  }
  .dropdown li + li {
    border-top: 1px solid var(--color-rule-soft);
  }
  .dropdown a:not(.d-pdf) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-2);
    padding: 12px 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .d-name {
    font: 400 20px/1.2 var(--font-display);
  }
  .d-price {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-brown);
    white-space: nowrap;
  }
  .dropdown a:not(.d-pdf):hover .d-name,
  .dropdown a[aria-current='page'] .d-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .d-pdf {
    font-size: 14px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
    margin-left: auto;
  }
  .nav-cta {
    display: none;
  }
  .burger :global(.i-close),
  .burger[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .burger[aria-expanded='true'] :global(.i-close) {
    display: block;
  }

  .mobile {
    height: calc(100svh - 72px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-paper);
    border-top: var(--hairline);
  }
  .mobile-inner {
    display: grid;
    gap: var(--spacing-3);
    padding-block: var(--spacing-3) max(var(--spacing-5), env(safe-area-inset-bottom));
  }
  .m-head {
    color: var(--color-ink-muted);
  }
  .m-services li + li,
  .m-links li + li {
    border-top: 1px solid var(--color-rule-soft);
  }
  .m-services a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-2);
    min-height: 52px;
    padding: 12px 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .m-name {
    font: 400 24px/1.2 var(--font-display);
  }
  .m-price {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-brown);
  }
  .m-links {
    border-top: var(--rule-double);
    padding-top: var(--spacing-1);
  }
  .m-links a {
    display: flex;
    align-items: center;
    min-height: 52px;
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .m-actions {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .nav-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1200px) {
    .desk {
      display: flex;
    }
    .actions {
      margin-left: var(--spacing-2);
    }
    .burger {
      display: none;
    }
    .mobile {
      display: none;
    }
  }
</style>
