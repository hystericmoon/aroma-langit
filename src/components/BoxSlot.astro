---
import Photo from './Photo.astro';
import type { Photo as PhotoT } from '../data/types';

interface Props {
  mode: 'hero' | 'label';
  fallback: PhotoT;
  sizes: string;
  class?: string;
  priority?: boolean;
  /** Text equivalent of the 3D scene for screen readers. */
  label: string;
}
const { mode, fallback, sizes, class: cls, priority = false, label } = Astro.props;
---

<div class:list={['box-slot', `box-slot-${mode}`, cls]} data-box-slot={mode} role="img" aria-label={label}>
  <div class="box-fallback" aria-hidden="true">
    <Photo photo={fallback} sizes={sizes} priority={priority} alt="" />
  </div>
</div>

<script>
  import '../scripts/box/stage';
</script>

<style>
  .box-slot {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }
  .box-slot-label {
    cursor: grab;
  }
  .box-slot-label:active {
    cursor: grabbing;
  }
  .box-fallback {
    position: absolute;
    inset: 0;
    transition: opacity 600ms var(--ease);
  }
  .box-fallback :global(picture),
  .box-fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The photo shows until the 3D canvas arrives in this slot, then crossfades out. */
  .box-slot:global(.has-canvas) .box-fallback {
    opacity: 0;
  }
</style>
