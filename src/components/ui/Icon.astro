---
// Line icons (brand book §5): 2px stroke, round caps and joins, currentColor. Always next to a
// text label and hidden from screen readers; icon-only buttons carry their own aria-label.
interface Props {
  name: 'minus' | 'plus' | 'check' | 'arrow-right' | 'chat' | 'close' | 'chevron-down' | 'menu' | 'download' | 'trash';
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  minus: 'M5 12h14',
  plus: 'M12 5v14M5 12h14',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  'arrow-right': 'M5 12h14m-6-6 6 6-6 6',
  chat: 'M21 11.5a8.4 8.4 0 0 1-12.2 7.5L3 21l2-5.6A8.4 8.4 0 1 1 21 11.5Z',
  close: 'M6 6l12 12M18 6 6 18',
  'chevron-down': 'm6 9 6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  download: 'M12 4v11m-5-5 5 5 5-5M5 20h14',
  trash: 'M4 7h16M10 11v6m4-6v6M6 7l1 13h10l1-13M9 7V4h6v3',
};
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
