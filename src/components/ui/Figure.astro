---
// Figure (brand book §6): a photo (1:1, 3:2 or 4:3), rounded 20px (12px with `small`) with a 1px
// ink border, and a meta caption. Alt describes the food; the caption adds context.
import Photo from '../Photo.astro';
import type { Photo as PhotoData } from '../../data/types';

interface Props {
  photo: PhotoData;
  ratio?: '1/1' | '3/2' | '4/3';
  caption?: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  alt?: string;
  position?: string;
  small?: boolean;
  class?: string;
}
const { photo, ratio = '3/2', caption, sizes, widths, priority, alt, position, small = false, class: cls } = Astro.props;
---

<figure class:list={['ui-figure', small && 'ui-figure--small', cls]} style={`--ratio: ${ratio}`}>
  <div class="ui-figure__img">
    <Photo photo={photo} sizes={sizes} widths={widths} priority={priority} alt={alt} position={position} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
