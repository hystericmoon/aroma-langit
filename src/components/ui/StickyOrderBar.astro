---
// StickyOrderBar (brand book §8): phones only. Paper, top hairline, the running total in mono
// and one orange button. The page script hides it while the estimator is on screen and while
// the keyboard is open; it respects the safe area.
interface Props {
  total: string;
  /** Small line under the total, e.g. the price per guest. */
  sub?: string;
  action: { href: string; label: string };
  /** Extra attributes for the action link (e.g. target, a data hook). */
  actionAttrs?: Record<string, string | boolean | undefined>;
  attrs?: Record<string, string | boolean | undefined>;
  totalAttrs?: Record<string, string | boolean | undefined>;
  subAttrs?: Record<string, string | boolean | undefined>;
  class?: string;
}
const { total, sub, action, actionAttrs, attrs, totalAttrs, subAttrs, class: cls } = Astro.props;
---

<div class:list={['ui-orderbar', cls]} {...attrs}>
  <p class="ui-orderbar__sum tab">
    <small>Perkiraan total</small>
    <strong {...totalAttrs}>{total}</strong>
    {sub !== undefined && <span {...subAttrs}>{sub}</span>}
  </p>
  <a class="ui-btn ui-btn--primary ui-btn--small" href={action.href} {...actionAttrs}><slot name="icon" />{action.label}</a>
</div>
