---
import NavyBand from '../ui/NavyBand.astro';
import { getSite } from '../../lib/content';

const site = await getSite();
---

<NavyBand id="proof-title" label="Mereka sudah makan dari dapur kami" class="proof">
  <p class="ui-band__text names" data-reveal>
    {
      site.clients.map((c, i) => (
        <>
          <span class="name">{c}</span>
          {i < site.clients.length - 1 && <span aria-hidden="true"> · </span>}
        </>
      ))
    }
  </p>
  <p class="more">serta berbagai instansi pemerintah, kampus, BUMN dan perusahaan swasta lainnya.</p>
</NavyBand>

<style>
  /* The home page's one NavyBand (brand book §7). Client names only with permission. */
  .names {
    text-wrap: pretty;
  }
  .name {
    white-space: nowrap;
  }
  .more {
    margin-top: var(--spacing-2);
    font-size: 15px;
  }
</style>
