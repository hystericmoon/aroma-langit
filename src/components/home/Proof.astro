---
import Photo from '../Photo.astro';
import { photos } from '../../data/photos';
import { getSite } from '../../lib/content';

const site = await getSite();
---

<section class="proof field-ink on-dark" aria-labelledby="proof-title">
  <div class="card field-paper" data-reveal>
    <h2 id="proof-title" class="proof-title">Mereka sudah makan dari dapur kami</h2>
    <figure class="tip">
      <Photo photo={photos.prasmananMalam} sizes="(min-width: 1024px) 46vw, 86vw" widths={[480, 720, 960, 1280]} />
    </figure>
    <p class="names">
      {
        site.clients.map((c, i) => (
          <>
            <span class="name">{c}</span>
            {i < site.clients.length - 1 && <span aria-hidden="true">&nbsp;·&nbsp; </span>}
          </>
        ))
      }
    </p>
    <p class="more t-small">serta berbagai instansi pemerintah, kampus, BUMN dan perusahaan swasta lainnya.</p>
  </div>
</section>

<style>
  .proof {
    padding-top: clamp(72px, 8vw, 128px);
    overflow: hidden;
    display: grid;
    justify-items: center;
  }
  .card {
    width: min(92%, 860px);
    padding: clamp(28px, 5vw, 64px) clamp(24px, 5vw, 64px) clamp(120px, 14vw, 200px);
    margin-bottom: clamp(-120px, -10vw, -60px);
    rotate: -1.5deg;
    text-align: center;
    display: grid;
    gap: clamp(24px, 3vw, 36px);
  }
  .proof-title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .tip {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }
  .tip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .names {
    font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.375rem);
    font-weight: 700;
    line-height: 1.75;
    text-wrap: balance;
  }
  .name {
    white-space: nowrap;
  }
  .more {
    color: var(--muted);
    max-width: 44ch;
    margin-inline: auto;
  }
</style>
