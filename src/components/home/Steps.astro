---
import Photo from '../Photo.astro';
import Icon from '../ui/Icon.astro';
import { photos } from '../../data/photos';
import { getSite } from '../../lib/content';
import { formatPercent, settlementText } from '../../lib/order';

const site = await getSite();
const steps = [
  { title: 'Susun labelnya', text: 'Pilih paket, jumlah dan tanggal acara di situs ini, lalu kirim lewat WhatsApp.', photo: photos.nasiboxBalado },
  { title: 'Kami balas', text: `Layanan pelanggan membalas pukul ${site.csHours}, memastikan menu dan total akhirnya.`, photo: photos.hidanganFlatlay },
  { title: 'Bayar uang muka', text: `Pesanan terkunci setelah uang muka ${formatPercent(site.depositRate)} masuk. ${settlementText(site.settlementDays)}`, photo: photos.dapurSayur },
  { title: 'Dimasak di Pasir Kuda', text: 'Juru masak bersertifikat penjamah makanan dan HACCP menyiapkannya di dapur kami.', photo: photos.dapurKoki },
  { title: 'Dikemas bersih', text: 'Setiap kotak diisi dengan sarung tangan, lalu ditutup dan disusun untuk diantar.', photo: photos.dapurPacking },
  { title: 'Tiba di acara Anda', text: 'Antar se-Kota Bogor sudah termasuk. Prasmanan datang dengan meja saji dan pramusaji.', photo: photos.prasmananOutdoor },
];
---

<section class="steps" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="head">
      <h2 id="steps-title" class="steps-title" data-split>Cara pesan, dari chat sampai sajian.</h2>
      <div class="ctrl">
        <button type="button" class="ui-btn ui-btn--secondary ui-btn--icon arrow" data-dir="-1" aria-label="Langkah sebelumnya" aria-controls="steps-row">
          <Icon name="arrow-left" />
        </button>
        <button type="button" class="ui-btn ui-btn--secondary ui-btn--icon arrow" data-dir="1" aria-label="Langkah berikutnya" aria-controls="steps-row">
          <Icon name="arrow-right" />
        </button>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="bar" aria-hidden="true"><div class="bar-fill" data-bar></div></div>
  </div>
  <ol class="row" id="steps-row" tabindex="0" aria-label="Langkah pemesanan, geser ke samping">
    {
      steps.map((s) => (
        <li class="col">
          <h3 class="col-title">{s.title}</h3>
          <p class="col-text">{s.text}</p>
          <div class="col-photo">
            <Photo photo={s.photo} sizes="(min-width: 768px) 300px, 72vw" widths={[360, 540, 720]} />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.steps')!;
  const row = root.querySelector<HTMLElement>('.row')!;
  const fill = root.querySelector<HTMLElement>('[data-bar]')!;
  const cols = Array.from(row.querySelectorAll<HTMLElement>('.col'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function progress() {
    const max = row.scrollWidth - row.clientWidth;
    const p = max > 0 ? row.scrollLeft / max : 0;
    fill.style.transform = `scaleX(${Math.max(0.08, p)})`;
  }
  row.addEventListener('scroll', progress, { passive: true });
  window.addEventListener('resize', progress);
  progress();

  function go(dir: number) {
    const x = row.scrollLeft;
    const pad = parseFloat(getComputedStyle(row).scrollPaddingLeft) || 0;
    const lefts = cols.map((c) => c.offsetLeft - pad);
    const target = dir > 0 ? lefts.find((l) => l > x + 4) : [...lefts].reverse().find((l) => l < x - 4);
    row.scrollTo({ left: target ?? (dir > 0 ? row.scrollWidth : 0), behavior: reduce.matches ? 'auto' : 'smooth' });
  }
  root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.dir))));
  row.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
  });

  // Drag to scroll with a mouse; touch keeps native scrolling.
  let down = false;
  let startX = 0;
  let startLeft = 0;
  let moved = false;
  row.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || e.button !== 0) return;
    down = true;
    moved = false;
    startX = e.clientX;
    startLeft = row.scrollLeft;
    row.classList.add('dragging');
  });
  window.addEventListener('pointermove', (e) => {
    if (!down) return;
    const dx = e.clientX - startX;
    if (Math.abs(dx) > 4) moved = true;
    row.scrollLeft = startLeft - dx;
  });
  window.addEventListener('pointerup', () => {
    if (!down) return;
    down = false;
    row.classList.remove('dragging');
  });
  row.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  row.addEventListener('dragstart', (e) => e.preventDefault());
</script>

<style>
  /* How to order: read mode. A sideways scroller of steps is not one of the brand book's
     components (flagged); built from SectionHeading, Figure and icon Buttons. */
  .steps {
    --side: max(var(--page-pad), calc((100vw - var(--page-max)) / 2 + var(--page-pad)));
    padding-block: var(--section-space);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--spacing-2);
    padding-top: var(--spacing-2);
    border-top: var(--rule-double);
  }
  .steps-title {
    max-width: 18ch;
    font: 400 32px/1.1 var(--font-display);
    text-wrap: balance;
  }
  .ctrl {
    display: flex;
    gap: var(--spacing-1);
  }
  .bar {
    height: 1px;
    margin-top: var(--spacing-3);
    background: var(--color-rule-soft);
  }
  .bar-fill {
    height: 2px;
    margin-top: -0.5px;
    background: var(--color-ink);
    transform-origin: left;
    transform: scaleX(0.08);
  }
  .row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 300px);
    gap: var(--spacing-3);
    margin: 0;
    padding: var(--spacing-3) var(--side) var(--spacing-1);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--side);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .row::-webkit-scrollbar {
    display: none;
  }
  .row:global(.dragging) {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .col {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--spacing-1);
    scroll-snap-align: start;
  }
  .col-title {
    font: 400 22px/1.2 var(--font-display);
  }
  .col-text {
    font-size: 15px;
    color: var(--color-ink-muted);
  }
  .col-photo {
    aspect-ratio: 1;
    overflow: hidden;
    margin-top: var(--spacing-1);
    background: var(--color-kraft);
  }
  .col-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .steps-title {
      font-size: 44px;
      line-height: 1.05;
    }
  }
</style>
