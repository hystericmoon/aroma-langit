---
import { getServices, getSite } from '../../lib/content';
import { formatRupiah, earliestDate, shippingLabel } from '../../lib/order';
import Field from '../ui/Field.astro';
import QuantityStepper from '../ui/QuantityStepper.astro';
import Choice from '../ui/Choice.astro';
import Nota from '../ui/Nota.astro';
import NotaLine from '../ui/NotaLine.astro';
import NotaTotal from '../ui/NotaTotal.astro';
import Icon from '../ui/Icon.astro';

const services = await getServices();
const site = await getSite();
const data = services.map((s) => ({
  slug: s.slug,
  title: s.title,
  leadDays: s.leadDays,
  packages: s.packages.map((p) => ({
    id: p.id,
    name: p.name,
    price: p.price,
    unit: p.unit,
    minOrder: p.minOrder,
    variants: p.variants.map((v) => v.name),
  })),
}));
const first = data[0];
const firstPkg = first.packages[Math.min(2, first.packages.length - 1)];
const genericText = 'Halo Aroma Langit, saya ingin memesan katering.';
---

<section id="pesan" class="order" aria-labelledby="order-title">
  <div class="intro">
    <h2 id="order-title" class="t-heading-2" data-split>Susun pesanan Anda.</h2>
    <p class="intro-lead">
      Pilih paket, jumlah dan tanggal. Kami hitung perkiraannya di sini, lalu pesan lengkapnya terkirim ke WhatsApp layanan pelanggan kami.
    </p>
    <p class="intro-more t-meta">Butuh beberapa menu sekaligus? <a class="ui-link" href="/kalkulator/">Pakai kalkulator katering</a>.</p>
  </div>
  <form class="panel field-kraft" action={`https://wa.me/${site.csPhone}`} method="get" target="_blank" novalidate data-order-form>
    <input type="hidden" name="text" value={genericText} data-order-text />
    <div class="fields">
      <Field id="order-service" label="Layanan">
        <select id="order-service" class="ui-input" data-order-service>
          {data.map((s) => <option value={s.slug} selected={s.slug === first.slug}>{s.title}</option>)}
        </select>
      </Field>
      <Field id="order-package" label="Paket">
        <select id="order-package" class="ui-input" data-order-package>
          {first.packages.map((p) => (
            <option value={p.id} selected={p.id === firstPkg.id}>
              {p.name} · {formatRupiah(p.price)}/{p.unit}
            </option>
          ))}
        </select>
      </Field>
      <div data-variant-field>
        <Field id="order-variant" label="Menu">
          <select id="order-variant" class="ui-input" data-order-variant>
            {firstPkg.variants.map((v) => <option value={v}>{v}</option>)}
          </select>
        </Field>
      </div>
      <Field id="order-qty" help={`Minimum ${firstPkg.minOrder} ${firstPkg.unit}.`} helpAttrs={{ 'data-order-qty-help': true }}>
        <Fragment slot="label">Jumlah <span class="unit" data-order-unit>{firstPkg.unit}</span></Fragment>
        <QuantityStepper
          id="order-qty"
          value={firstPkg.minOrder}
          decLabel="Kurangi jumlah"
          incLabel="Tambah jumlah"
          inputAttrs={{ 'data-order-qty': true, 'aria-describedby': 'order-qty-help' }}
        />
      </Field>
      <Field id="order-date" label="Tanggal acara" help={`Pesan paling lambat H-${first.leadDays}.`} helpAttrs={{ 'data-order-date-help': true }}>
        <input id="order-date" class="ui-input" type="date" min={earliestDate(first.leadDays)} data-order-date aria-describedby="order-date-help" />
      </Field>
      <Choice
        name="area"
        legend="Diantar ke"
        options={[
          { value: 'kota-bogor', label: 'Kota Bogor', checked: true, attrs: { 'data-order-area': true } },
          { value: 'luar-bogor', label: 'Luar Kota Bogor', attrs: { 'data-order-area': true } },
        ]}
      />
    </div>

    <Nota id="order-nota" title="Label pesanan" heading={false} class="nota">
      <NotaLine label="Harga" amount={formatRupiah(firstPkg.price * firstPkg.minOrder)} amountAttrs={{ 'data-sum-sub': true }} attrs={{ 'data-order-summary': true }} />
      <NotaLine label="Biaya di bawah minimum" amount="Rp0" variant="surcharge" hidden attrs={{ 'data-sum-extra-row': true }} amountAttrs={{ 'data-sum-extra': true }} />
      <NotaLine label="Ongkos kirim" amount={shippingLabel['kota-bogor']} amountAttrs={{ 'data-sum-ship': true }} />
      <NotaTotal
        slot="total"
        label="Perkiraan total"
        amount={formatRupiah(firstPkg.price * firstPkg.minOrder)}
        amountAttrs={{ 'data-sum-total': true }}
        liveAttrs={{ 'data-sum-live': true }}
      />
    </Nota>

    <div class="actions">
      <button type="submit" class="ui-btn ui-btn--primary send">
        <Icon name="chat" />
        Kirim ke WhatsApp
      </button>
      <button type="button" class="ui-link copy" data-order-copy>Salin pesan</button>
    </div>
  </form>
  <script type="application/json" id="order-data" set:html={JSON.stringify(data)} />
  <script type="application/json" id="order-config" set:html={JSON.stringify({ phone: site.csPhone })} />
  <noscript><style>.copy, .nota { display: none; }</style></noscript>
</section>

<script>
  import { setOrder } from '../../lib/orderStore';
  import {
    buildMessage, checkDate, clampQty, earliestDate, estimate, formatDateLong, formatRupiah, shippingLabel, type Area,
  } from '../../lib/order';

  interface Pkg { id: string; name: string; price: number; unit: string; minOrder: number; variants: string[] }
  interface Svc { slug: string; title: string; leadDays: number; packages: Pkg[] }

  const data: Svc[] = JSON.parse(document.getElementById('order-data')!.textContent || '[]');
  const { phone } = JSON.parse(document.getElementById('order-config')!.textContent || '{}') as { phone: string };
  const form = document.querySelector<HTMLFormElement>('[data-order-form]')!;
  const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
  const svcSel = $<HTMLSelectElement>('[data-order-service]');
  const pkgSel = $<HTMLSelectElement>('[data-order-package]');
  const varSel = $<HTMLSelectElement>('[data-order-variant]');
  const varField = $<HTMLElement>('[data-variant-field]');
  const qtyIn = $<HTMLInputElement>('[data-order-qty]');
  const qtyHelp = $<HTMLElement>('[data-order-qty-help]');
  const unitEl = $<HTMLElement>('[data-order-unit]');
  const dateIn = $<HTMLInputElement>('[data-order-date]');
  const dateHelp = $<HTMLElement>('[data-order-date-help]');
  const areaIns = form.querySelectorAll<HTMLInputElement>('[data-order-area]');
  const textIn = $<HTMLInputElement>('[data-order-text]');
  const subEl = $<HTMLElement>('[data-sum-sub]');
  const extraRow = $<HTMLElement>('[data-sum-extra-row]');
  const extraEl = $<HTMLElement>('[data-sum-extra]');
  const shipEl = $<HTMLElement>('[data-sum-ship]');
  const totalEl = $<HTMLElement>('[data-sum-total]');
  const liveEl = $<HTMLElement>('[data-sum-live]');
  const copyBtn = $<HTMLButtonElement>('[data-order-copy]');

  let qtyTouched = false;
  let shownTotal = 0; // the figure on screen, updated every frame
  let tween = 0;
  let settle = 0;
  let liveTimer = 0;

  const svc = () => data.find((s) => s.slug === svcSel.value) ?? data[0];
  const pkg = () => svc().packages.find((p) => p.id === pkgSel.value) ?? svc().packages[0];
  const area = (): Area => (Array.from(areaIns).find((i) => i.checked)?.value as Area) || 'kota-bogor';

  function fillPackages(keepId?: string) {
    const s = svc();
    pkgSel.innerHTML = '';
    for (const p of s.packages) {
      const o = document.createElement('option');
      o.value = p.id;
      o.textContent = `${p.name} · ${formatRupiah(p.price)}/${p.unit}`;
      pkgSel.append(o);
    }
    const pick = s.packages.find((p) => p.id === keepId) ?? s.packages[Math.min(2, s.packages.length - 1)];
    pkgSel.value = pick.id;
    dateIn.min = earliestDate(s.leadDays);
  }

  function fillVariants() {
    const p = pkg();
    varSel.innerHTML = '';
    for (const v of p.variants) {
      const o = document.createElement('option');
      o.value = v;
      o.textContent = v;
      varSel.append(o);
    }
    varField.hidden = p.variants.length < 2;
  }

  // A small lift on the total. Never restarted while running, so fast changes do not jitter.
  function bump(el: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || el.getAnimations().length) return;
    el.animate([{ transform: 'none' }, { transform: 'translateY(-4px)' }, { transform: 'none' }], {
      duration: 200,
      easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
    });
  }

  function animateTotal(to: number, live = false) {
    cancelAnimationFrame(tween);
    clearTimeout(settle);
    const from = shownTotal;
    const show = (v: number) => {
      shownTotal = v;
      totalEl.textContent = formatRupiah(v);
    };
    if (from === to || live || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      show(to);
      return;
    }
    const start = performance.now();
    const dur = 240;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      const e = 1 - Math.pow(1 - t, 3);
      show(Math.round(from + (to - from) * e));
      if (t < 1) tween = requestAnimationFrame(step);
    };
    tween = requestAnimationFrame(step);
    // Frames can stall (a busy GPU, a background tab); never leave a half-counted figure.
    settle = window.setTimeout(() => {
      cancelAnimationFrame(tween);
      show(to);
    }, dur + 100);
    bump(totalEl);
  }

  /** opts.live: the change comes from typing, so the total updates without motion. */
  function update(opts?: { live?: boolean }) {
    const s = svc();
    const p = pkg();
    const qty = clampQty(qtyIn.value);
    const e = estimate(p, qty);
    unitEl.textContent = p.unit;
    dateIn.min = earliestDate(s.leadDays);

    qtyHelp.textContent = e.belowMinimum
      ? `Minimum ${p.minOrder} ${p.unit}. Kurang ${e.shortfall} ${p.unit}, jadi ada biaya tambahan 20% dari selisihnya.`
      : p.minOrder > 1 ? `Minimum ${p.minOrder} ${p.unit}.` : `Satu ${p.unit} untuk 20–25 orang.`;
    qtyHelp.classList.toggle('warn', e.belowMinimum);

    const dc = checkDate(dateIn.value, s.leadDays);
    if (dc === 'too-soon') {
      dateHelp.textContent = `${s.title} perlu dipesan paling lambat H-${s.leadDays}. Tanggal paling cepat: ${formatDateLong(earliestDate(s.leadDays))}. Tetap bisa ditanyakan lewat WhatsApp.`;
    } else if (dc === 'invalid') {
      dateHelp.textContent = 'Tanggal tidak dikenali. Pilih dari kalender.';
    } else if (dc === 'ok') {
      dateHelp.textContent = formatDateLong(dateIn.value);
    } else {
      dateHelp.textContent = `Pesan paling lambat H-${s.leadDays}.`;
    }
    dateHelp.classList.toggle('warn', dc === 'too-soon' || dc === 'invalid');
    dateIn.setAttribute('aria-invalid', String(dc === 'too-soon' || dc === 'invalid'));

    subEl.textContent = formatRupiah(e.subtotal);
    extraRow.hidden = !e.belowMinimum;
    extraEl.textContent = formatRupiah(e.surcharge);
    shipEl.textContent = shippingLabel[area()];
    animateTotal(e.total, opts?.live === true);

    const draft = {
      serviceName: s.title, leadDays: s.leadDays, pkg: p,
      variant: p.variants.length > 1 ? varSel.value : undefined,
      qty: e.qty, date: dc === 'ok' || dc === 'too-soon' ? dateIn.value : '', area: area(),
    };
    const msg = buildMessage(draft);
    textIn.value = msg;

    clearTimeout(liveTimer);
    liveTimer = window.setTimeout(() => {
      liveEl.textContent = `Perkiraan total ${formatRupiah(e.total)} untuk ${e.qty} ${p.unit} ${s.title} ${p.name}.`;
    }, 700);

    setOrder({
      serviceSlug: s.slug, serviceName: s.title, leadDays: s.leadDays,
      pkgId: p.id, pkgName: p.name, price: p.price, unit: p.unit, minOrder: p.minOrder,
      variant: draft.variant ?? '', qty: e.qty, date: draft.date, area: area(),
    });
  }

  function choose(serviceSlug?: string | null, pkgId?: string | null) {
    if (serviceSlug && data.some((s) => s.slug === serviceSlug)) {
      svcSel.value = serviceSlug;
      fillPackages(pkgId ?? undefined);
    } else if (pkgId && svc().packages.some((p) => p.id === pkgId)) {
      pkgSel.value = pkgId;
    }
    fillVariants();
    qtyTouched = false;
    qtyIn.value = String(pkg().minOrder);
    update();
  }

  // A new service has a different unit, so the quantity starts again from its minimum.
  svcSel.addEventListener('change', () => { fillPackages(); fillVariants(); qtyTouched = false; qtyIn.value = String(pkg().minOrder); update(); });
  pkgSel.addEventListener('change', () => { fillVariants(); if (!qtyTouched) qtyIn.value = String(pkg().minOrder); update(); });
  varSel.addEventListener('change', () => update());
  qtyIn.addEventListener('input', () => { qtyTouched = true; update({ live: true }); });
  qtyIn.addEventListener('blur', () => { qtyIn.value = String(clampQty(qtyIn.value)); update(); });
  dateIn.addEventListener('change', () => update());
  dateIn.addEventListener('input', () => update());
  areaIns.forEach((i) => i.addEventListener('change', () => update()));
  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = pkg();
      const stepSize = p.minOrder >= 25 ? 5 : 1;
      const cur = clampQty(qtyIn.value);
      const dir = Number(b.dataset.step);
      const next = dir > 0 ? Math.floor(cur / stepSize) * stepSize + stepSize : Math.ceil(cur / stepSize) * stepSize - stepSize;
      qtyIn.value = String(clampQty(next));
      qtyTouched = true;
      update();
    }),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    update();
    const url = `https://wa.me/${phone}?text=${encodeURIComponent(textIn.value)}`;
    const w = window.open(url, '_blank', 'noopener');
    if (!w) window.location.href = url;
  });

  copyBtn.addEventListener('click', async () => {
    update();
    try {
      await navigator.clipboard.writeText(textIn.value);
      copyBtn.textContent = 'Tersalin';
    } catch {
      const ta = document.createElement('textarea');
      ta.value = textIn.value;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      copyBtn.textContent = ok ? 'Tersalin' : 'Gagal menyalin';
    }
    window.setTimeout(() => (copyBtn.textContent = 'Salin pesan'), 2200);
  });

  window.addEventListener('aroma:pick', (e) => {
    const d = (e as CustomEvent<{ service?: string; pkg?: string }>).detail;
    choose(d.service, d.pkg);
  });

  // Prefill from links such as /?layanan=nasi-box&paket=standar#pesan
  const params = new URLSearchParams(location.search);
  fillVariants();
  if (params.get('layanan') || params.get('paket')) choose(params.get('layanan'), params.get('paket'));
  else update();
</script>

<style>
  /* Order panel (brand book §7 home recipe): Fields + Nota + the one primary button, on the
     kraft order zone. The narrow column beside the price list on desktop. */
  .order {
    display: grid;
    gap: var(--spacing-3);
    align-content: start;
    min-width: 0;
  }
  .intro {
    display: grid;
    gap: var(--spacing-1);
    padding-top: var(--spacing-2);
    border-top: var(--rule-double);
  }
  .intro-lead {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 15px;
  }
  .intro-more {
    margin: 0;
  }
  .panel {
    display: grid;
    gap: var(--spacing-3);
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
  }
  .fields {
    display: grid;
    gap: var(--spacing-2);
  }
  [data-variant-field][hidden] {
    display: none;
  }
  .panel :global(.ui-help.warn) {
    color: var(--color-chili);
    font-weight: 600;
  }
  .actions {
    display: grid;
    gap: 12px;
    justify-items: center;
  }
  .send {
    width: 100%;
  }
  .copy {
    min-height: var(--tap-min);
    padding: 0 var(--spacing-1);
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
