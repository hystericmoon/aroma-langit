---
import Coupon from '../Coupon.astro';
---

<section class="corp field-paper" aria-labelledby="kantor-title">
  <div class="wrap">
    <Coupon id="kantor" />
    <p class="more t-small">
      Ingin tahu dulu cara kerjanya? <a class="link" href="/korporat/">Baca tentang katering kantor</a>.
    </p>
  </div>
</section>

<style>
  .corp {
    padding-block: calc(var(--section) * 0.9) clamp(64px, 7vw, 112px);
    --coupon-ground: var(--paper);
  }
  .more {
    margin-top: 20px;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
