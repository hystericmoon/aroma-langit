---
import Figure from '../ui/Figure.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Tabs from '../ui/Tabs.astro';
import { getServices } from '../../lib/content';
import { formatRupiah } from '../../lib/order';

const services = (await getServices()).filter((s) => s.gallery.length > 0);
const from = (s: (typeof services)[number]) => Math.min(...s.packages.map((p) => p.price));
---

<section class="show" aria-labelledby="show-title">
  <div class="wrap">
    <SectionHeading id="show-title" title="Seperti ini sampainya." split />
    <Tabs label="Pilih layanan" class="show-tabs" tabs={services.map((s) => ({ id: `tab-${s.slug}`, label: s.title, controls: `panel-${s.slug}` }))} />
    {
      services.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={i !== 0} data-panel>
          <div class="photos">
            {[s.photo, ...s.gallery.filter((g) => g !== s.photo)].slice(0, 4).map((ph, k) => (
              <Figure
                photo={ph}
                ratio={k === 0 ? '3/2' : '1/1'}
                class={k === 0 ? 'big' : 'small'}
                sizes={k === 0 ? '(min-width: 1024px) 46vw, 92vw' : '(min-width: 1024px) 15vw, 30vw'}
                widths={k === 0 ? [480, 720, 960, 1280] : [240, 360, 480]}
              />
            ))}
          </div>
          <div class="copy">
            <h3 class="t-heading-2 panel-title">{s.title}</h3>
            <p class="t-lead panel-tag">{s.tagline}</p>
            <p class="t-body measure panel-intro">{s.intro}</p>
            <dl class="facts tab">
              <div>
                <dt>Mulai</dt>
                <dd>{formatRupiah(from(s))}/{s.unit}</dd>
              </div>
              <div>
                <dt>Paket</dt>
                <dd>{s.packages.length} pilihan</dd>
              </div>
              <div>
                <dt>Pesan paling lambat</dt>
                <dd>H-{s.leadDays}</dd>
              </div>
            </dl>
            <div class="cells">
              <a class="ui-btn ui-btn--secondary" href={`/?layanan=${s.slug}#pesan`} data-pick-service={s.slug}>
                Pesan {s.title}
              </a>
              <a class="ui-link" href={`/katering/${s.slug}/`}>
                Lihat isi menu
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.show')!;
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

  function select(i: number, focus = false) {
    tabs.forEach((t, k) => {
      t.setAttribute('aria-selected', String(k === i));
      t.tabIndex = k === i ? 0 : -1;
    });
    panels.forEach((p, k) => (p.hidden = k !== i));
    if (focus) tabs[i].focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      const k = e.key;
      let n = -1;
      if (k === 'ArrowRight') n = (i + 1) % tabs.length;
      else if (k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
      else if (k === 'Home') n = 0;
      else if (k === 'End') n = tabs.length - 1;
      if (n >= 0) {
        e.preventDefault();
        select(n, true);
      }
    });
  });

  // "Pesan" cells fill the order label in place instead of reloading the page.
  root.querySelectorAll<HTMLAnchorElement>('[data-pick-service]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!document.getElementById('pesan')) return;
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('aroma:pick', { detail: { service: a.dataset.pickService } }));
      const target = document.getElementById('pesan')!;
      if (window.__lenis) window.__lenis.scrollTo(target, { offset: -88, duration: 1.2 });
      else target.scrollIntoView();
    }),
  );
</script>

<style>
  /* Photo gallery (brand book §7 home recipe): read mode, Figures, with pill Tabs per service. */
  .show {
    padding-block: var(--section-space);
  }
  .show :global(.show-tabs) {
    margin-block: var(--spacing-3);
  }
  .panel {
    display: grid;
    gap: var(--spacing-4);
  }
  .panel[hidden] {
    display: none;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .photos :global(.big) {
    grid-column: 1 / -1;
  }
  .copy {
    display: grid;
    gap: var(--spacing-2);
    align-content: start;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--spacing-1) 0 0;
    border-top: var(--hairline);
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding: 12px 12px 0 0;
  }
  .facts div + div {
    padding-left: 12px;
    border-left: 1px solid var(--color-rule-soft);
  }
  .facts dt {
    font-size: 13px;
    color: var(--color-ink-muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .cells {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2) var(--spacing-3);
    margin-top: var(--spacing-1);
  }
  @media (min-width: 1024px) {
    .panel {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--spacing-5);
      align-items: start;
    }
  }
</style>
