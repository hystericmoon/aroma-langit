---
import { getPresets, getServices } from '../../lib/content';
import { buildCatalog, computePlan, planFromPreset } from '../../lib/calculator';
import { weddingCatering } from '../../data/wedding';
import { formatRupiah } from '../../lib/order';
import SectionHeading from '../ui/SectionHeading.astro';
import EventTile from '../ui/EventTile.astro';

const presets = await getPresets();
const catalog = buildCatalog(await getServices(), weddingCatering);
const rows = presets
  .filter((p) => p.items.length > 0)
  .map((p) => {
    const r = computePlan(planFromPreset(p, catalog), catalog);
    return { ...p, perGuest: r.perGuest, total: r.total };
  });
---

<section class="teaser" aria-labelledby="teaser-title">
  <div class="wrap">
    <SectionHeading
      id="teaser-title"
      title="Satu acara, banyak menu?"
      context="Kalkulator katering menyusun seluruh acara sekaligus: snack pagi, makan siang, tumpeng untuk dipotong. Mulai dari contoh acara di bawah, lalu ubah sesuka Anda."
      link={{ href: '/kalkulator/', label: 'Buka kalkulator' }}
      split
    />
    <ul role="list" class="ui-tiles t-list" data-reveal>
      {
        rows.map((r) => (
          <li>
            <EventTile
              href={`/kalkulator/?acara=${r.id}`}
              title={r.title}
              desc={`${r.guests} ${r.guestWord}`}
              price={`sekitar ${formatRupiah(r.perGuest)} per ${r.guestWord}`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* EventTiles (brand book §7 home recipe): order mode, straight after the hero. */
  .teaser {
    padding-block: var(--spacing-4) var(--section-space);
  }
  .t-list {
    margin-top: var(--spacing-3);
  }
</style>
