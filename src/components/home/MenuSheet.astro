---
import SectionHeading from '../ui/SectionHeading.astro';
import Tabs from '../ui/Tabs.astro';
import PriceRow from '../ui/PriceRow.astro';
import { getServices, getSite } from '../../lib/content';
import { formatRupiah, leadTimeSummary } from '../../lib/order';

const services = await getServices();
const site = await getSite();
const all = services.flatMap((s) => s.packages);
const lo = Math.min(...all.map((p) => p.price));
const hi = Math.max(...all.map((p) => p.price));
---

<section id="menu" class="menu" aria-labelledby="menu-title">
  <SectionHeading
    id="menu-title"
    title="Menu & harga"
    context={`${all.length} paket dari ${formatRupiah(lo)} sampai ${formatRupiah(hi)}. Ketuk satu baris untuk memasukkannya ke label pesanan.`}
    link={{ href: site.pricelistUrl, label: 'Unduh daftar harga lengkap (PDF, 1,4 MB)', download: true }}
    split
  />
  <div class="sheet" data-tabs>
    <Tabs
      label="Pilih layanan"
      class="sheet-tabs"
      tabs={services.map((s) => ({ id: `menu-tab-${s.slug}`, label: s.title, controls: `menu-panel-${s.slug}` }))}
    />
    <p class="t-meta sheet-note">Harga sudah termasuk antar se-Kota Bogor untuk pesanan yang memenuhi minimum.</p>
    {
      services.map((s, i) => (
        <section class="group" id={`menu-panel-${s.slug}`} role="tabpanel" aria-labelledby={`menu-tab-${s.slug}`} hidden={i !== 0} data-group={s.slug}>
          <div class="group-head">
            <h3 class="group-name">{s.title}</h3>
            <a class="ui-link ui-link--tap group-link" href={`/katering/${s.slug}/`}>
              Lihat isi menu<span class="sr-only"> {s.title}</span>
            </a>
          </div>
          <ul role="list" class="ui-price-list">
            {s.packages.map((p) => (
              <PriceRow
                name={p.name}
                srPrefix={s.title}
                meta={[p.minOrder > 1 ? `Minimum ${p.minOrder} ${p.unit}` : '', p.note ?? ''].filter(Boolean).join(' · ')}
                price={formatRupiah(p.price)}
                unit={p.unit}
                pickLabel={`Pilih ${s.title} ${p.name}, masukkan ke label pesanan`}
                pickAttrs={{ 'data-pick-service': s.slug, 'data-pick-package': p.id }}
              />
            ))}
          </ul>
        </section>
      ))
    }
    <p class="t-meta sheet-foot">{leadTimeSummary(services)}</p>
  </div>
</section>

<script>
  const root = document.getElementById('menu')!;
  const picks = root.querySelectorAll<HTMLButtonElement>('[data-pick-service]');

  root.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pick-service]');
    if (!btn) return;
    window.dispatchEvent(new CustomEvent('aroma:pick', { detail: { service: btn.dataset.pickService, pkg: btn.dataset.pickPackage } }));
    const target = document.getElementById('pesan');
    if (target) {
      if (window.__lenis) window.__lenis.scrollTo(target, { offset: -88, duration: 1.2 });
      else target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      window.setTimeout(() => document.getElementById('order-qty')?.focus({ preventScroll: true }), 900);
    }
  });

  // The selected state follows the order label, whichever way the package was chosen.
  window.addEventListener('aroma:order', (e) => {
    const o = (e as CustomEvent<{ serviceSlug: string; pkgId: string }>).detail;
    picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pickService === o.serviceSlug && b.dataset.pickPackage === o.pkgId)));
  });
</script>

<style>
  /* Price list (brand book §7 home recipe): Tabs + PriceRows, the wide column beside the
     order panel. */
  .menu {
    display: grid;
    gap: var(--spacing-3);
    align-content: start;
    min-width: 0;
  }
  .sheet {
    display: grid;
    gap: var(--spacing-2);
  }
  .sheet-note,
  .sheet-foot {
    margin: 0;
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-1) var(--spacing-2);
    padding-bottom: var(--spacing-1);
    border-bottom: var(--hairline);
  }
  .group-name {
    font: 400 24px/1.2 var(--font-display);
  }
  .group-link {
    font-size: 14px;
  }
  .group[hidden] {
    display: none;
  }
</style>
