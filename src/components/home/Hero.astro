---
import BoxSlot from '../BoxSlot.astro';
import Icon from '../ui/Icon.astro';
import { photos } from '../../data/photos';
import { getServices, getSite } from '../../lib/content';
import { formatRupiah } from '../../lib/order';

const site = await getSite();
// The price tag on the hero photo (a nasi box) reads from data: that service's lowest price.
const services = await getServices();
const tagService = services.find((s) => s.slug === 'nasi-box') ?? services[0];
const tagPrice = Math.min(...tagService.packages.map((p) => p.price));
---

<section class="hero" data-box-scroll aria-labelledby="hero-title">
  <div class="pin" data-box-pin>
    <div class="wrap hero-grid">
      <div class="copy">
        <h1 id="hero-title" class="t-display hero-title">
          <span class="intro-line"><span>Katering halal</span></span>
          <span class="intro-line"><span>dari Bogor.</span></span>
        </h1>
        <p class="t-lead hero-sub intro-fade">
          Nasi box, tumpeng dan prasmanan untuk rapat, syukuran sampai resepsi. Dimasak di dapur kami di Pasir Kuda, harga sudah termasuk antar se-Kota Bogor.
        </p>
        <div class="hero-actions intro-fade">
          <a class="ui-btn ui-btn--primary" href="#pesan">
            Susun pesanan
            <Icon name="arrow-right" />
          </a>
          <a class="ui-link hero-link" href="#menu">Lihat menu &amp; harga</a>
        </div>
        <ul role="list" class="facts intro-fade">
          <li><strong>Halal BPJPH</strong><span class="tab">{site.halal.number}</span></li>
          <li><strong>Laik Higiene</strong><span>Jasaboga {site.hygiene.grade}</span></li>
          <li><strong>Sejak 2017</strong><span>Jatinangor, Bandung, Bogor</span></li>
        </ul>
      </div>
      <div class="stage">
        <div class="slot-wrap">
          <BoxSlot
            mode="hero"
            fallback={photos.nasiboxRendang}
            sizes="(min-width: 1024px) 50vw, 100vw"
            priority
            class="hero-slot"
            label="Nasi box Aroma Langit yang terbuka, berisi nasi kuning, ayam bakar, perkedel, sambal, lalapan, jeruk dan kerupuk"
          />
          <p class="price-tag">Mulai <span class="price-tag__amount">{formatRupiah(tagPrice)}</span><span class="price-tag__unit">/{tagService.unit}</span></p>
        </div>
        <p class="hint t-meta" aria-hidden="true">Gulir untuk membuka kotak</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero (brand book §8): Fraunces display, body intro, primary + secondary action, the facts
     strip, and the rounded, bordered photo with a white "Mulai Rp…" price tag. */
  .hero-grid {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-4) var(--section-space);
  }
  .copy {
    display: grid;
    gap: var(--spacing-3);
    align-content: center;
  }
  /* The reveal mask leaves room above (Fraunces ascenders) and below (descenders). */
  .hero-title .intro-line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.1em;
    margin-block: -0.12em -0.1em;
  }
  .hero-title .intro-line > span {
    display: block;
    animation: rise 250ms var(--ease-out) both;
  }
  .hero-title .intro-line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
    }
  }
  .intro-fade {
    animation: fade-up 250ms var(--ease-out) both;
    animation-delay: 100ms;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .hero-sub {
    max-width: 34ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2) var(--spacing-3);
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  /* Stats strip: not specified in the brand book (flagged); hairline-separated facts.
     Rows on phones, three columns from 600px. */
  .facts {
    display: grid;
    border-top: var(--hairline);
  }
  .facts li {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-2);
    padding: 10px 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-ink-muted);
  }
  .facts li + li {
    border-top: 1px solid var(--color-rule-soft);
  }
  .facts li span {
    text-align: right;
  }
  @media (min-width: 600px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .facts li {
      display: grid;
      gap: 2px;
      padding: 12px 12px 0 0;
    }
    .facts li span {
      text-align: left;
      overflow-wrap: anywhere;
    }
    .facts li + li {
      padding-left: 12px;
      border-top: 0;
      border-left: 1px solid var(--color-rule-soft);
    }
  }
  .facts strong {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink);
  }
  .stage {
    display: grid;
    gap: 10px;
    align-content: center;
  }
  .slot-wrap {
    position: relative;
  }
  .stage :global(.hero-slot) {
    position: relative;
    aspect-ratio: 4 / 3;
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-kraft);
  }
  /* Price tag (brand book §8): white, 12px radius, hairline, the amount in mono. */
  .price-tag {
    position: absolute;
    left: var(--spacing-2);
    bottom: var(--spacing-2);
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 12px;
    border: var(--hairline);
    border-radius: var(--radius-input);
    background: var(--color-card);
    font: 600 14px/1.2 var(--font-sans);
  }
  .price-tag__amount {
    font: 600 24px/1.2 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .price-tag__unit {
    margin-left: -4px;
    font: 400 13px/1.2 var(--font-sans);
    color: var(--color-ink-muted);
  }
  .hint {
    display: none;
  }

  @media (min-width: 1024px) {
    /* Desktop only: the hero pins while the box opens. Phones never pin (no scroll-jacking). */
    .hero {
      height: 175svh;
    }
    .pin {
      position: sticky;
      top: 73px;
      height: calc(100svh - 73px);
      display: flex;
      align-items: center;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: var(--spacing-5);
      padding-block: var(--spacing-4);
    }
    .hint {
      display: block;
    }
  }
  /* Under reduced motion the box does not open on scroll, so there is nothing to pin for. */
  @media (min-width: 1024px) and (max-height: 760px), (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .pin {
      position: static;
      height: auto;
    }
  }
</style>
