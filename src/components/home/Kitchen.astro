---
import Figure from '../ui/Figure.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import TrustStamps from '../ui/TrustStamps.astro';
import { photos } from '../../data/photos';
import { getSite } from '../../lib/content';

const site = await getSite();
---

<section class="kitchen" aria-labelledby="kitchen-title">
  <div class="wrap">
    <SectionHeading
      id="kitchen-title"
      title="Dapur yang boleh Anda periksa."
      context="Bersih bukan janji di brosur. Dapur kami di Pasir Kuda bersertifikat Laik Higiene dari Dinas Kesehatan Kota Bogor, dan setiap produknya bersertifikat halal BPJPH."
      split
    />
    <div class="board">
      <Figure
        photo={photos.dapurLuas}
        ratio="3/2"
        class="wide"
        caption="Dapur produksi di Jl. Jabaru II, Pasir Kuda, Bogor Barat."
        sizes="(min-width: 1024px) 62vw, 100vw"
        widths={[720, 1080, 1440, 1920]}
      />
      <div class="stub" data-reveal>
        <TrustStamps details class="stamps" />
        <div class="cert">
          <h3 class="cert-h">Sertifikasi tim</h3>
          <ul role="list" class="staff">
            {site.staffCerts.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
      <div class="minis">
        <Figure photo={photos.dapurPotongPaprika} ratio="1/1" small sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
        <Figure photo={photos.dapurBaki} ratio="1/1" small sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
        <Figure photo={photos.dapurSayur} ratio="1/1" small sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
      </div>
    </div>
  </div>
</section>

<style>
  /* Kitchen and certificates: the trust stamps (brand book §8) on a white card beside the
     kitchen photo. */
  .kitchen {
    padding-bottom: var(--section-space);
  }
  .board {
    display: grid;
    gap: var(--spacing-3);
    margin-top: var(--spacing-3);
  }
  .stub {
    display: grid;
    gap: var(--spacing-3);
    align-content: start;
    justify-items: start;
    padding: var(--spacing-3);
    border: var(--hairline);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }
  .stub :global(.stamps) {
    flex-direction: column;
  }
  .stub :global(.ui-stamp-item) {
    flex: none;
  }
  .cert {
    display: grid;
    gap: 4px;
    width: 100%;
    padding-top: var(--spacing-2);
    border-top: 1px solid var(--color-rule-soft);
  }
  .cert-h {
    font: 700 16px/1.3 var(--font-sans);
  }
  .staff {
    display: grid;
    gap: 4px;
    font-size: 14px;
  }
  .minis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 1024px) {
    .board {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: start;
    }
    .minis {
      grid-column: 1 / -1;
    }
  }
</style>
