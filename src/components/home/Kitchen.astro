---
import Photo from '../Photo.astro';
import { photos } from '../../data/photos';
import { getSite } from '../../lib/content';

const site = await getSite();
---

<section class="kitchen field-orange" aria-labelledby="kitchen-title">
  <div class="wrap">
    <div class="top">
      <h2 id="kitchen-title" class="t-h2" data-split>Dapur yang boleh Anda periksa.</h2>
      <p class="t-lead lead">
        Bersih bukan janji di brosur. Dapur kami di Pasir Kuda bersertifikat Laik Higiene dari Dinas Kesehatan Kota Bogor, dan setiap produknya bersertifikat halal BPJPH.
      </p>
    </div>

    <div class="board">
      <figure class="wide">
        <div class="wide-img">
          <div class="pan" data-parallax="6">
            <Photo photo={photos.dapurLuas} sizes="(min-width: 1024px) 62vw, 100vw" widths={[720, 1080, 1440, 1920]} />
          </div>
        </div>
        <figcaption class="t-small cap">Dapur produksi di Jl. Jabaru II, Pasir Kuda, Bogor Barat.</figcaption>
        <div class="seal" data-sticker="-6" aria-hidden="true">
          <span class="seal-big">Halal</span>
          <span class="seal-small">BPJPH</span>
        </div>
      </figure>

      <div class="stub field-paper" data-reveal>
        <div class="cert">
          <h3 class="cert-h">Sertifikat Halal</h3>
          <p class="cert-num tab">{site.halal.number}</p>
          <p class="t-small cert-meta">Badan Penyelenggara Jaminan Produk Halal, berdasarkan ketetapan halal MUI {site.halal.decree}, {site.halal.date}.</p>
        </div>
        <div class="cert">
          <h3 class="cert-h">Laik Higiene Sanitasi Jasaboga {site.hygiene.grade}</h3>
          <p class="cert-num tab">{site.hygiene.number}</p>
          <p class="t-small cert-meta">Diterbitkan {site.hygiene.issuer}.</p>
        </div>
        <div class="cert">
          <h3 class="cert-h">Sertifikasi tim</h3>
          <ul role="list" class="staff">
            {site.staffCerts.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>

      <div class="minis">
        <figure class="mini">
          <Photo photo={photos.dapurPotongPaprika} sizes="(min-width: 1024px) 20vw, 50vw" widths={[360, 540, 720]} />
        </figure>
        <figure class="mini">
          <Photo photo={photos.dapurBaki} sizes="(min-width: 1024px) 20vw, 50vw" widths={[360, 540, 720]} />
        </figure>
        <figure class="mini">
          <Photo photo={photos.dapurSayur} sizes="(min-width: 1024px) 20vw, 50vw" widths={[360, 540, 720]} />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .kitchen {
    padding-block: var(--section) clamp(72px, 8vw, 128px);
  }
  .top {
    display: grid;
    gap: 24px;
    align-items: end;
  }
  .top h2 {
    max-width: 13ch;
  }
  .lead {
    max-width: 38ch;
  }
  .board {
    display: grid;
    gap: 12px;
    margin-top: clamp(40px, 6vw, 88px);
  }
  .wide {
    position: relative;
  }
  .wide-img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink);
  }
  .pan {
    height: 112%;
    margin-top: -6%;
  }
  .pan :global(picture),
  .pan :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cap {
    margin-top: 10px;
  }
  .seal {
    position: absolute;
    top: clamp(-28px, -2vw, -16px);
    right: clamp(12px, 3vw, 40px);
    display: grid;
    place-content: center;
    text-align: center;
    width: clamp(96px, 11vw, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    rotate: -6deg;
    line-height: 1;
  }
  .seal-big {
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .seal-small {
    font-size: var(--step-small);
    font-weight: 700;
    margin-top: 4px;
    color: var(--peach);
  }
  .stub {
    display: grid;
    gap: 2px;
    background: var(--paper-2);
  }
  .cert {
    display: grid;
    gap: 6px;
    padding: 24px clamp(20px, 3vw, 36px);
    background: var(--paper);
  }
  .cert-h {
    font-size: 1rem;
    font-weight: 700;
  }
  .cert-num {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .cert-meta {
    color: var(--muted);
  }
  .staff {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .staff li {
    padding: 6px 12px;
    background: var(--paper-2);
    font-size: var(--step-small);
    font-weight: 700;
  }
  .minis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .mini {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink);
  }
  .mini :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .board {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas: 'wide stub' 'minis minis';
      align-items: start;
    }
    .wide {
      grid-area: wide;
    }
    .stub {
      grid-area: stub;
    }
    .minis {
      grid-area: minis;
    }
  }
</style>
