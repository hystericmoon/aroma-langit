---
import Figure from '../ui/Figure.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Chip from '../ui/Chip.astro';
import { photos } from '../../data/photos';
import { getSite } from '../../lib/content';

const site = await getSite();
---

<section class="kitchen" aria-labelledby="kitchen-title">
  <div class="wrap">
    <SectionHeading
      id="kitchen-title"
      title="Dapur yang boleh Anda periksa."
      context="Bersih bukan janji di brosur. Dapur kami di Pasir Kuda bersertifikat Laik Higiene dari Dinas Kesehatan Kota Bogor, dan setiap produknya bersertifikat halal BPJPH."
      split
    />
    <div class="board">
      <Figure
        photo={photos.dapurLuas}
        ratio="3/2"
        class="wide"
        caption="Dapur produksi di Jl. Jabaru II, Pasir Kuda, Bogor Barat."
        sizes="(min-width: 1024px) 62vw, 100vw"
        widths={[720, 1080, 1440, 1920]}
      />
      <div class="stub" data-reveal>
        <Chip variant="halal" aria-hidden="true">Halal BPJPH</Chip>
        <div class="cert">
          <h3 class="cert-h">Sertifikat Halal</h3>
          <p class="cert-num tab">{site.halal.number}</p>
          <p class="t-meta">Badan Penyelenggara Jaminan Produk Halal, berdasarkan ketetapan halal MUI {site.halal.decree}, {site.halal.date}.</p>
        </div>
        <div class="cert">
          <h3 class="cert-h">Laik Higiene Sanitasi Jasaboga {site.hygiene.grade}</h3>
          <p class="cert-num tab">{site.hygiene.number}</p>
          <p class="t-meta">Diterbitkan {site.hygiene.issuer}.</p>
        </div>
        <div class="cert">
          <h3 class="cert-h">Sertifikasi tim</h3>
          <ul role="list" class="staff">
            {site.staffCerts.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
      <div class="minis">
        <Figure photo={photos.dapurPotongPaprika} ratio="1/1" sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
        <Figure photo={photos.dapurBaki} ratio="1/1" sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
        <Figure photo={photos.dapurSayur} ratio="1/1" sizes="(min-width: 1024px) 20vw, 33vw" widths={[360, 540, 720]} />
      </div>
    </div>
  </div>
</section>

<style>
  /* Kitchen and certificates (brand book §7 home recipe): read mode. */
  .kitchen {
    padding-block: var(--section-space);
  }
  .board {
    display: grid;
    gap: var(--spacing-3);
    margin-top: var(--spacing-3);
  }
  .stub {
    display: grid;
    gap: var(--spacing-3);
    align-content: start;
    justify-items: start;
    padding: var(--spacing-3);
    border: var(--hairline);
  }
  .cert {
    display: grid;
    gap: 4px;
  }
  .cert + .cert {
    width: 100%;
    padding-top: var(--spacing-2);
    border-top: 1px solid var(--color-rule-soft);
  }
  .cert-h {
    font: 400 22px/1.2 var(--font-display);
  }
  .cert-num {
    font-weight: 600;
    font-size: 15px;
  }
  .staff {
    display: grid;
    gap: 4px;
    font-size: 15px;
  }
  .minis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 1024px) {
    .board {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: start;
    }
    .minis {
      grid-column: 1 / -1;
    }
  }
</style>
